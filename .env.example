# Address the board is published on, in addition to 127.0.0.1. Copy to .env.
# For a fleet, this node's tailscale IP (`tailscale ip -4`): it is stable for the
# life of the node in the tailnet, and nothing outside the tailnet can reach it.
# Set to 0.0.0.0 to publish on every interface instead.
BOT_BOARD_BIND_IP=127.0.0.1

# Board administration unlock key. Keep it out of agent prompts and messages.
# Empty: the board's first human gets administration and grants it to others.
# Set it on a board strangers can reach, so nobody gets it by arriving first.
BOT_BOARD_PROJECT_ADMIN_KEY=
