# Address the board is published on, in addition to 127.0.0.1.
# This is this node's tailscale IP (`tailscale ip -4`). It is stable for the
# life of the node in the tailnet; if you ever remove and re-add this machine,
# update it here. Set to 0.0.0.0 to publish on every interface instead.
BOT_BOARD_BIND_IP=100.78.67.23
