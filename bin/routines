#!/usr/bin/env python3
"""routines — recurring work for the fleet, at the cost of a bot only when there is some.

  routines run [--interval 30]     the runner: keep checking, fire, follow up (one per board, on a box with the credentials the checks need)
  routines once                    one pass of the same, then exit
  routines ls [--as HANDLE]        every routine on the board and where it stands
  routines add --name N --channel C (--check FILE --prompt FILE | --recipe FILE) [--about TEXT] [--every 2m]
               [--claim-timeout 5m] [--done-timeout 30m] [--resends 3] [--skill S]
               [--thread MSG | --id ROUTINE] [--as HANDLE]
                                   store a routine on the board, paused (--thread: the message it was asked
                                   for in; --id: a new version of that routine, paused again)
  routines check <id> | --file FILE [--watermark JSON] [--as HANDLE]
                                   dry run: what the check finds now; posts nothing. It runs the
                                   script here, as you: read a routine's check before you run it

--as HANDLE acts as a bot whose token is on this box (the admin bot storing a
routine does it under its own name); without it, as the runner.

A routine is stored on the board (GET /api/routines; app/routines.py): a check
(a script), a prompt, and a few settings. The check costs no tokens: the runner
runs it every `every` seconds, and only when it finds work does a message go to
the routine's project channel, the prompt plus what the check found, for a
standby bot to claim like any other work.

A human asks the admin bot for a routine in a channel; the bot works it out with
them there and stores it through the API, paused. The board decides who may
enable, pause, test, change or delete it (see app/routines.py); this runner runs
the ones that are enabled, answers the tests asked for, and reports a failure
back, which pauses the routine until it is enabled again.

The check prints one JSON object:
    {"work": true, "found": "text or a list of lines for the bot", "watermark": <anything>}
`watermark` comes back in $ROUTINE_WATERMARK (as JSON) on later runs, but only
once a bot has finished the job that carried it, so work a bot never finished
is found again. {"work": false} means nothing to do.

A fired job is followed until it is done. No claim within claim_timeout, or a
claim with no result within done_timeout: it is sent again in the same thread,
`resends` times, then reported as failed. Any reply from the bot on it, a note
of progress say, starts done_timeout again. A job is done when a bot replies in
its thread with meta {"done": true}. One job per routine is open at a time, so
however fast the check runs, a routine costs at most one bot run at a time.

A routine can also be written as a recipe (`recipe`) instead of a check of its
own. The one recipe now, `github-issues`, watches a repository's open issues that
nobody has taken and routes each to a group of a project: its check and its
prompt are written from the recipe (recipe_check, recipe_prompt), and stored, so
what a human approves is what runs. Issues a label rule places are announced by
the runner without a bot; the rest go out as one job, a few at a time, for a bot
to pick the group, and the bot answers with meta {"done": true, "routes":
[{"number", "group", "why"}]}. The runner announces each issue in its group's
channel once, then chases it: no bot reply in that thread, no assignee and no
linked pull request after `remind_after`, it is posted again, `reminds` times,
then `escalate` is told.

Env: BOARD and BOT_INVITE (also read from ~/.config/bot_board/config), ROUTINES_HANDLE
(default routines: the board takes reports only from that agent), ROUTINES_CONFIG_DIR
(where the token and state live, default ~/.config/bot_board; the board sets it
when it runs the runner itself), ROUTINES_PROJECT
(default admin: the project whose bot pool are the admin bots and whose managers
switch routines; read by the board). The runner's token is
~/.config/bot_board/<handle>.token and what it remembers between passes is
~/.config/bot_board/routines/state.json; without that file each routine with
work fires once more.
"""
import argparse, hashlib, json, os, re, signal, shlex, subprocess, sys, tempfile, time, urllib.error, urllib.request
from datetime import datetime, timezone

CFG = os.path.expanduser(os.environ.get("ROUTINES_CONFIG_DIR") or "~/.config/bot_board")
DEFAULTS = {"every": 120, "claim_timeout": 300, "done_timeout": 1800, "resends": 3}
CHECK_TIMEOUT = 120


def die(msg):
    sys.exit(f"routines: {msg}")


def setting(name, default=""):
    """The environment, else a plain NAME=value line in the config bin/bot reads."""
    if os.environ.get(name):
        return os.environ[name]
    try:
        for line in open(os.environ.get("BOT_CONFIG") or os.path.join(CFG, "config"), encoding="utf-8"):
            m = re.match(rf"\s*(?:export\s+)?{name}=(.*)$", line)
            if m:
                return "".join(shlex.split(m.group(1), comments=True)[:1])   # a shell file: quotes, trailing comment
    except OSError:
        pass
    return default


BOARD = setting("BOARD", "http://127.0.0.1:8080").rstrip("/")
ME = setting("ROUTINES_HANDLE", "routines")


def call(method, path, body=None, token=None):
    req = urllib.request.Request(BOARD + path, method=method,
                                 data=None if body is None else json.dumps(body).encode())
    req.add_header("content-type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 409:
            return {"status": 409}
        raise ConnectionError(f"{method} {path}: {e.code} {e.read().decode(errors='replace')[:300]}") from None
    except OSError as e:
        raise ConnectionError(f"{method} {path}: {e}") from None


def token_of(handle, register=False):
    path = os.path.join(CFG, f"{handle}.token")
    if os.path.isfile(path) and os.path.getsize(path):
        return open(path).read().strip()
    if not register:
        die(f"no token for {handle} at {path}")
    body = {"handle": handle, "kind": "cron",
            "description": f"runs the board's routines on {os.uname().nodename}: checks on a timer, posts work when there is some"}
    if setting("BOT_INVITE"):
        body["invite_code"] = setting("BOT_INVITE")
    got = call("POST", "/api/agents", body)
    if "token" not in got:
        die(f"the handle {handle} is taken on {BOARD} and its token is not at {path}; "
            "copy the token here, or set ROUTINES_HANDLE")
    os.makedirs(CFG, mode=0o700, exist_ok=True)
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
        fh.write(got["token"] + "\n")
    return got["token"]


def problem_with(routine):
    """Why a definition cannot run, or ''."""
    for key in ("name", "channel", "check", "prompt"):
        if not isinstance(routine.get(key), str) or not routine[key].strip():
            return f"`{key}` is missing or not text"
    for key in DEFAULTS:
        if type(routine.get(key)) is not int or routine[key] < (key == "every"):
            return f"`{key}` must be a whole number of {'times' if key == 'resends' else 'seconds'}"
    for key in ("about", "skill"):
        if not isinstance(routine.get(key, ""), str):
            return f"`{key}` is not text"
    if "recipe" in routine:
        rc = routine["recipe"]
        if not isinstance(rc, dict) or set(rc) != set(recipe_of({}) or {}):
            return "`recipe` is not a complete recipe"
        if recipe_problem(rc):
            return recipe_problem(rc)
        version = routine.get("recipe_version")
        if type(version) is not int or not 1 <= version <= RECIPE_VERSION:
            return "`recipe_version` is missing or not one this runner knows"
        if version == RECIPE_VERSION and (routine["check"] != recipe_check(rc) or routine["prompt"] != recipe_prompt(rc)):
            return "its check or prompt is not what its recipe writes"
    return ""


# ---------------------------------------------------------------- recipes

# Bump when recipe_check or recipe_prompt changes what they write. A definition keeps
# the version it was written with: what a human approved is its stored check and
# prompt (the message shows them), so an older one keeps running after a release
# instead of turning invalid; it is checked against the writer only while current.
RECIPE_VERSION = 1
RECIPE_DEFAULTS = {"unassigned": True, "no_linked_pr": True, "skip_labels": ["claimed", "in-progress"],
                   "batch": 5, "after": "", "rules": [], "remind_after": 7200, "reminds": 3, "escalate": ""}
REPO_RE = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+")
NAME_RE = re.compile(r"[a-z0-9][a-z0-9._-]{1,63}")


def recipe_of(data):
    """A recipe with every setting present: what is stored and what the code is taken from."""
    rc = {"type": data.get("type"), "repo": data.get("repo"), "project": data.get("project")}
    rc.update({k: data.get(k, v) for k, v in RECIPE_DEFAULTS.items()})
    if isinstance(rc["after"], str) and rc["after"]:
        # The check compares it with gh's createdAt as text, which is always UTC with a Z.
        try:
            t = datetime.fromisoformat(rc["after"].replace("Z", "+00:00"))
            if t.tzinfo:
                rc["after"] = t.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        except ValueError:
            pass    # recipe_problem says what is wrong with it
    return rc


def recipe_problem(rc):
    """Why a recipe cannot run, or ''."""
    if rc.get("type") != "github-issues":
        return "the recipe `type` must be github-issues"
    if not isinstance(rc.get("repo"), str) or not REPO_RE.fullmatch(rc["repo"]):
        return "the recipe `repo` must be owner/name"
    if not isinstance(rc.get("project"), str) or not NAME_RE.fullmatch(rc["project"]):
        return "the recipe `project` must be a project slug"
    for key in ("unassigned", "no_linked_pr"):
        if type(rc.get(key)) is not bool:
            return f"the recipe `{key}` must be true or false"
    if not isinstance(rc.get("skip_labels"), list) or not all(isinstance(x, str) and x.strip() for x in rc["skip_labels"]):
        return "the recipe `skip_labels` must be a list of labels"
    for key, low, high in (("batch", 1, 50), ("remind_after", 60, 30 * 86400), ("reminds", 0, 20)):
        if type(rc.get(key)) is not int or not low <= rc[key] <= high:
            return f"the recipe `{key}` must be a whole number from {low} to {high}"
    if not isinstance(rc.get("after"), str) or (rc["after"] and not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", rc["after"])):
        return "the recipe `after` must be empty or an ISO time in UTC (2026-10-14T21:00:00Z)"
    if not isinstance(rc.get("escalate"), str) or (rc["escalate"] and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{1,31}", rc["escalate"])):
        return "the recipe `escalate` must be empty or a handle"
    rules = rc.get("rules")
    if not isinstance(rules, list) or not all(isinstance(x, dict) and set(x) == {"label", "group"}
                                              and isinstance(x["label"], str) and x["label"].strip()
                                              and isinstance(x["group"], str) and NAME_RE.fullmatch(x["group"])
                                              for x in rules):
        return "the recipe `rules` must be a list of {label, group}"
    return ""


def recipe_check(rc):
    """The check a github-issues recipe runs: open issues nobody has taken and the routine
    has not announced yet (the watermark is the list of numbers it has), `batch` at a time."""
    cfg = {k: rc[k] for k in ("unassigned", "no_linked_pr", "skip_labels", "batch", "after", "rules")}
    return f"""#!/bin/sh
# Written from the routine's recipe: edit the recipe, not this.
# Open issues in {rc['repo']} that nobody has taken and this routine has not announced.
set -e
gh issue list -R {rc['repo']} --state open --limit 1000 \\
  --json number,title,url,labels,assignees,createdAt,closedByPullRequestsReferences > issues.json
exec python3 - <<'PY'
import json, os
cfg = json.loads({json.dumps(json.dumps(cfg, sort_keys=True))})
sent = set(json.loads(os.environ.get("ROUTINE_WATERMARK") or "[]"))
skip = set(cfg["skip_labels"])
rules = {{r["label"]: r["group"] for r in cfg["rules"]}}
new = []
for i in sorted(json.load(open("issues.json")), key=lambda i: i["number"]):
    labels = [l["name"] for l in i["labels"]]
    if i["number"] in sent or skip & set(labels) or (cfg["after"] and i["createdAt"] <= cfg["after"]):
        continue
    if (cfg["unassigned"] and i["assignees"]) or (cfg["no_linked_pr"] and i["closedByPullRequestsReferences"]):
        continue
    group = next((rules[l] for l in labels if l in rules), "")
    new.append({{"number": i["number"], "title": i["title"], "url": i["url"], "labels": labels, "group": group}})
batch = new[:cfg["batch"]]
print(json.dumps({{"work": bool(batch),
                  "found": [f"#{{i['number']}} {{i['title']}} {{i['url']}}" + (f" (rule: {{i['group']}})" if i["group"] else "")
                            for i in batch] + ([f"and {{len(new) - len(batch)}} more after these"] if len(new) > len(batch) else []),
                  "items": batch,
                  "watermark": sorted(sent | {{i["number"] for i in batch}})}}))
PY
"""


def recipe_prompt(rc):
    return (f"Route each GitHub issue below, from {rc['repo']}, to the group of project `{rc['project']}` "
            f"it belongs to. The groups and what each is for are at GET /api/projects/{rc['project']} "
            f"(`groups`: slug, purpose, scope); read the issue (`gh issue view <n> -R {rc['repo']}`) when the "
            "title is not enough. Issues marked with a rule already have their group: keep it.\n\n"
            "Do not announce the issues yourself and do not assign anyone: the runner posts each one in its "
            "group's channel and follows it up. Reply in this thread with `meta` "
            '`{"done": true, "routes": [{"number": 34, "group": "economy", "why": "one line on why"}]}`, '
            "one route per issue. An issue that fits no group gets `\"group\": \"\"` and goes to the project channel.")


def recipe_summary(rc):
    taken = ["it has an assignee"] * rc["unassigned"] + ["a pull request is linked to it"] * rc["no_linked_pr"]
    taken += [f"it is labelled {', '.join(rc['skip_labels'])}"] * bool(rc["skip_labels"])
    lines = [f"- Watches open issues in {rc['repo']}"
             + (f" opened after {rc['after']}" if rc["after"] else "")
             + (f", skipping any where {' or '.join(taken)}" if taken else "")
             + f"; each is announced once, {rc['batch']} at a time.",
             f"- Routes each to a group of project `{rc['project']}`"
             + ("; label rules: " + ", ".join(f"`{x['label']}` → {x['group']}" for x in rc["rules"]) if rc["rules"] else "")
             + ". A bot picks the group for the rest."]
    if rc["reminds"]:
        lines.append(f"- An announced issue no bot has taken is posted again after {mins(rc['remind_after'])}, "
                     f"{rc['reminds']} times" + (f", then @{rc['escalate']} is told." if rc["escalate"] else "."))
    return "\n".join(lines) + "\n"


class Board:
    def __init__(self, handle=None):
        """As a bot on this box (its token file), else as the runner, registering it on first use."""
        self.token = token_of(handle or ME, register=not handle)

    def pages(self, path):
        since = 0
        while True:
            got = call("GET", f"{path}{'&' if '?' in path else '?'}since={since}", token=self.token)
            yield from got.get("messages", [])
            if not got.get("has_more"):
                return
            since = got["next_since"]

    def post(self, channel, body, reply_to=None, meta=None):
        return call("POST", "/api/messages", {"channel": channel, "body": body, "reply_to": reply_to,
                                              "meta": meta or {}}, self.token)["message"]

    def routines(self):
        """Every routine on the board, with its state."""
        return call("GET", "/api/routines?full=0", token=self.token)["routines"]

    def report(self, r, **body):
        return call("POST", f"/api/routines/{r['id']}/report", body, self.token)


def duration(text):
    m = re.fullmatch(r"(\d+)([smhd]?)", str(text))
    if not m:
        die(f"not a duration: {text} (use 90, 2m, 1h)")
    return int(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]


def mins(secs):
    return f"{secs // 60} min" if secs >= 120 else f"{secs}s"


class CheckError(Exception):
    pass


class ProjectGone(Exception):
    pass


def secrets():
    """Secrets checks get in their environment on top of the runner's own. None here; the
    board, when it runs the runner, replaces this with the fleet's secrets (set on /fleet)."""
    return {}


def run_check(script, name="", watermark=None):
    """Run a routine's check; returns its JSON object."""
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, "check")
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(script)
        os.chmod(path, 0o700)
        env = {**os.environ, **secrets(), "ROUTINE_NAME": name,
               "ROUTINE_WATERMARK": "" if watermark is None else json.dumps(watermark)}
        try:
            p = subprocess.Popen([path] if script.startswith("#!") else ["bash", path], cwd=tmp, env=env,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
        except OSError as e:
            raise CheckError(f"the check could not start: {e}") from None
        try:
            stdout, stderr = p.communicate(timeout=CHECK_TIMEOUT)
        except subprocess.TimeoutExpired:
            os.killpg(p.pid, signal.SIGKILL)    # the check and whatever it started
            p.communicate()
            raise CheckError(f"the check ran longer than {CHECK_TIMEOUT}s") from None
    if p.returncode:
        raise CheckError(f"the check exited {p.returncode}: {(stderr or stdout).strip()[-600:]}")
    try:
        out = json.loads(stdout)
        if not isinstance(out, dict) or not isinstance(out.get("work"), bool):
            raise ValueError
    except ValueError:
        raise CheckError('the check must print one JSON object with "work": true or false; '
                         f"it printed: {stdout.strip()[:300]}") from None
    return out


def found_text(found):
    if isinstance(found, list):
        return "\n".join(f"- {x}" for x in found)
    return str(found or "").strip()


def when(ts):
    return datetime.fromisoformat(ts).timestamp()


# ---------------------------------------------------------------- the runner

class Runner:
    def __init__(self):
        self.board = Board()
        self.path = os.path.join(CFG, "routines", "state.json")
        try:
            self.state = json.load(open(self.path))
        except (OSError, ValueError):
            self.state = {}

    def save(self):
        os.makedirs(os.path.dirname(self.path), mode=0o700, exist_ok=True)
        with open(self.path + ".tmp", "w") as fh:
            json.dump(self.state, fh, indent=1)
        os.replace(self.path + ".tmp", self.path)

    def log(self, r, text):
        print(f"{datetime.now().astimezone().isoformat(timespec='seconds')} {r['name']}: {text}", flush=True)

    def fail(self, r, st, why):
        """Report it, which stops the routine until it is enabled again, and tell the humans once."""
        self.board.report(r, failed=why, version=r["version"])
        self.board.post("heads-up", f"Routine `{r['name']}` stopped: {why} It stays paused until it is enabled "
                        f"again: {BOARD}/routines#r={r['id']}", meta={"routine": r["id"]})
        st.pop("job", None)
        self.log(r, f"failed: {why}")

    def tick(self):
        for r in self.board.routines():
            st = self.state.setdefault(str(r["id"]), {})
            try:
                if r["test_pending"] and r["test_asked"] > st.get("tested", 0):
                    self.test(r, st)
                if r["state"] != "enabled" or r["problem"]:
                    st.pop("job", None)     # paused or replaced mid-job: the next enable starts clean
                    if r["state"] == "enabled" and st.get("refused") != r["version"]:
                        st["refused"] = r["version"]
                        self.log(r, f"cannot run: {r['problem']}")
                    continue
                if st.get("version") != r["version"]:
                    st.update(version=r["version"], checked_at=0)
                    st.pop("job", None)
                if r.get("recipe"):
                    try:
                        self.chase(r, st)
                    except Exception as e:      # reminders wait; the routine's own work goes on
                        self.log(r, f"chasing skipped this pass: {type(e).__name__}: {e}")
                if "job" in st:
                    self.follow(r, st)
                elif time.time() - st.get("checked_at", 0) >= r["every"]:
                    self.check(r, st)
            except ConnectionError as e:
                self.log(r, f"board call failed, will retry: {e}")
            except Exception as e:      # one routine going wrong must not stop the others
                self.log(r, f"skipped this pass: {type(e).__name__}: {e}")
            finally:
                self.save()

    def test(self, r, st):
        """Run the check once and report what it found. Fires nothing, and leaves the
        watermark, the job and the next check where they were."""
        asked = r["test_asked"]
        res = {"for": asked, "version": r["version"], "ok": False, "work": False, "found": None,
               "watermark": None, "error": None}
        if r["problem"]:
            res["error"] = f"this definition cannot run: {r['problem']}"
        else:
            try:
                out = run_check(r["check"], r["name"], st.get("watermark"))
                res.update(ok=True, work=out["work"], found=out.get("found"), watermark=out.get("watermark"))
            except CheckError as e:
                res["error"] = str(e)
        self.board.report(r, test=res)
        st["tested"] = asked
        self.log(r, f"tested ({asked}): " + (res["error"] or ("work" if res["work"] else "no work")))

    def check(self, r, st):
        st["checked_at"] = time.time()
        try:
            out = run_check(r["check"], r["name"], st.get("watermark"))
        except CheckError as e:
            return self.fail(r, st, str(e))
        if not out["work"]:
            return
        items = out.get("items") if r.get("recipe") and isinstance(out.get("items"), list) else None
        if items and all(i.get("group") for i in items):   # every one placed by a label rule: no bot needed
            try:
                self.announce(r, st, items, {})
            except ProjectGone as e:
                return self.fail(r, st, f"{e}; nothing was announced.")
            st["watermark"] = out.get("watermark")
            return
        body = (f"{r['prompt'].strip()}\n\n**Found by the check:**\n{found_text(out.get('found'))}\n\n---\n"
                f"Routine `{r['name']}` ({BOARD}/routines#r={r['id']}). One thread worker takes this. "
                "When it is finished, reply in this thread with the result and `meta` `{\"done\": true}`; "
                f"without that it is sent again after {mins(r['done_timeout'])}.")
        meta = {"routine": r["id"], "name": r["name"]}
        if r.get("skill"):
            meta["skill"] = r["skill"]
        m = self.board.post(r["channel"], body, meta=meta)
        st["job"] = {"msg": m["id"], "sent": m["id"], "sent_at": time.time(), "sends": 1,
                     "watermark": out.get("watermark")}
        if items:
            st["job"]["items"] = items
        self.log(r, f"work found, fired as message {m['id']} in #{r['channel']}")

    def follow(self, r, st):
        job = st["job"]
        messages = list(self.board.pages(f"/api/threads/{job['msg']}"))
        root = next(m for m in messages if m["id"] == job["msg"])
        worker = root.get("worker")
        replies = [m for m in messages
                   if m["id"] > job["msg"] and m["author"] != ME and m["author_kind"] != "human"]
        done = next((m for m in replies if m["meta"].get("done") is True), None)
        if done:
            if job.get("items"):
                routes = done["meta"].get("routes")
                routes = {x.get("number"): x for x in routes if isinstance(x, dict)} if isinstance(routes, list) else {}
                try:
                    self.announce(r, st, job["items"], routes)
                except ProjectGone as e:
                    return self.fail(r, st, f"{e}; nothing was announced.")
            st["watermark"] = job["watermark"]
            del st["job"]
            return self.log(r, f"done by {done['author']} (message {done['id']})")
        claim = next((m for m in reversed(replies) if m["id"] > job["sent"]
                      and (not worker or m["author"] == worker)), None)
        if worker or claim:
            last = max(job["sent_at"], when(root["worker_claimed_at"]) if worker else 0,
                       when(claim["created_at"]) if claim else 0)
            if time.time() - last < r["done_timeout"]:
                return
            why = f"@{worker or claim['author']} is on this and has posted nothing for {mins(r['done_timeout'])}"
        elif time.time() - job["sent_at"] >= r["claim_timeout"]:
            why = f"nobody took this in {mins(r['claim_timeout'])}"
        else:
            return
        if job["sends"] > r["resends"]:
            return self.fail(r, st, f"message {job['msg']} in #{r['channel']} was sent {job['sends']} times and "
                             f"never finished ({why}).")
        m = self.board.post(r["channel"], f"Still open: {why}. The thread worker continues; unclaimed work is available for pickup. The task is the first message "
                            "of this thread. Reply with the result and `meta` `{\"done\": true}` when finished.",
                            reply_to=job["msg"], meta={"routine": r["id"], "name": r["name"], "resend": job["sends"]})
        job.update(sent=m["id"], sent_at=time.time(), sends=job["sends"] + 1)
        self.log(r, f"sent again ({why}), message {m['id']}")


    # ---- recipes: announce each item once, then chase it until a bot takes it

    def project(self, slug):
        try:
            p = call("GET", f"/api/projects/{slug}", token=self.board.token)["project"]
        except ConnectionError as e:
            if ": 404 " in str(e):
                raise ProjectGone(f"the project `{slug}` this routine routes to does not exist") from None
            raise
        if p.get("archived"):
            raise ProjectGone(f"the project `{slug}` this routine routes to is archived")
        return p["channel"], {g["slug"]: g["channel"] for g in p.get("groups", []) if not g.get("archived")}

    def announce(self, r, st, items, routes):
        rc = r["recipe"]
        home, groups = self.project(rc["project"])
        items_st = st.setdefault("items", {})
        for i in items:
            if str(i["number"]) in items_st:
                continue
            route = routes.get(i["number"]) or {}
            group = i.get("group") or str(route.get("group") or "")
            why = "label rule" if i.get("group") else str(route.get("why") or "").strip()[:300]
            channel = groups.get(group, home)
            body = (f"New issue to take: #{i['number']} {i['title']}\n{i['url']}\n\n"
                    + (f"Routed to {group}: {why}.\n" if channel != home and why else
                       f"Routed to {group}.\n" if channel != home else "No group fits it, so it is here.\n")
                    + f"The thread worker should assign the issue to itself: "
                    f"`gh issue edit {i['number']} -R {rc['repo']} --add-assignee @me`.")
            m = self.board.post(channel, body, meta={"routine": r["id"], "name": r["name"],
                                                     "routine_item": {"repo": rc["repo"], "number": i["number"]}})
            items_st[str(i["number"])] = {"msg": m["id"], "channel": channel, "sent_at": time.time(), "reminds": 0}
            self.log(r, f"announced #{i['number']} in #{channel} as message {m['id']}")

    def taken(self, r, item):
        """A worker claimed the thread, or the issue moved on on GitHub."""
        if any(m.get("worker") or
               (m["id"] > item["msg"] and m["author"] != ME and m["author_kind"] != "human")
               for m in self.board.pages(f"/api/threads/{item['msg']}")):
            return "a bot took it"
        try:
            got = json.loads(subprocess.run(
                ["gh", "issue", "view", str(item["number"]), "-R", r["recipe"]["repo"],
                 "--json", "state,assignees,closedByPullRequestsReferences"],
                capture_output=True, text=True, timeout=60, check=True).stdout)
        except (OSError, ValueError, subprocess.SubprocessError):
            return ""       # GitHub unreachable: ask again on the next pass
        if got["state"] != "OPEN":
            return "closed"
        if got["assignees"] or got["closedByPullRequestsReferences"]:
            return "assigned or linked to a pull request"
        return ""

    def chase(self, r, st):
        rc = r["recipe"]
        for number, item in list(st.get("items", {}).items()):
            if item.get("over") or time.time() - item["sent_at"] < rc["remind_after"]:
                continue
            item["number"] = int(number)
            why = self.taken(r, item)
            if why:
                item["over"] = why
                self.log(r, f"#{number}: {why}")
            elif item["reminds"] < rc["reminds"]:
                item["reminds"] += 1
                item["sent_at"] = time.time()
                self.board.post(item["channel"], f"Still nobody on #{number} after {mins(rc['remind_after'])} "
                                f"(reminder {item['reminds']} of {rc['reminds']}). Anyone free: reply here to take it.",
                                reply_to=item["msg"], meta={"routine": r["id"], "name": r["name"],
                                                            "routine_item": {"repo": rc["repo"], "number": int(number)}})
                self.log(r, f"reminded #{number} ({item['reminds']} of {rc['reminds']})")
            else:
                item["over"] = "no taker"
                if rc["escalate"]:
                    home, _ = self.project(rc["project"])
                    self.board.post(home, f"@{rc['escalate']} #{number} has had no taker after {rc['reminds']} "
                                    f"reminders: message {item['msg']} in #{item['channel']}.",
                                    meta={"routine": r["id"], "name": r["name"]})
                self.log(r, f"#{number}: no taker after {rc['reminds']} reminders")
            self.save()


# ---------------------------------------------------------------- commands

def cmd_ls(a):
    try:
        state = json.load(open(os.path.join(CFG, "routines", "state.json")))
    except (OSError, ValueError):
        state = {}
    rows = [("NAME", "ID", "FIRES IN", "EVERY", "STATE")]
    for r in Board(a.as_handle).routines():
        st = state.get(str(r["id"]), {})
        job = st.get("job") if st.get("version") == r["version"] else None
        rows.append((r["name"], str(r["id"]), "#" + r["channel"], mins(r["every"]),
                     r["state"] + (f", cannot run: {r['problem']}" if r["problem"] else "")
                     + (f", job open: message {job['msg']}, sent {job['sends']}x" if job and r["state"] == "enabled" else "")))
    if len(rows) == 1:
        return print(f"routines: none on {BOARD}", file=sys.stderr)
    for row in rows:
        print("  ".join(c.ljust(max(len(x[i]) for x in rows)) for i, c in enumerate(row)).rstrip())


def cmd_check(a):
    if a.file:
        script, name, mark = open(a.file, encoding="utf-8").read(), os.path.basename(a.file), None
    elif a.id:
        r = next((r for r in Board(a.as_handle).routines() if r["id"] == a.id), None) or die(f"no routine {a.id}")
        if r["problem"]:
            die(f"routine {a.id} cannot run: {r['problem']}")
        script, name = r["check"], r["name"]
        try:
            mark = json.load(open(os.path.join(CFG, "routines", "state.json"))).get(str(a.id), {}).get("watermark")
        except (OSError, ValueError):
            mark = None
    else:
        die("check needs a routine id or --file")
    if a.watermark:
        mark = json.loads(a.watermark)
    try:
        out = run_check(script, name, mark)
    except CheckError as e:
        die(str(e))
    if not out["work"]:
        return print("no work: the routine would post nothing")
    print(f"work: the routine would fire with this appended to its prompt:\n\n{found_text(out.get('found'))}\n\n"
          f"watermark once a bot finishes: {json.dumps(out.get('watermark'))}")


def cmd_add(a):
    body = {"name": a.name, "channel": a.channel, "every": duration(a.every), "claim_timeout": duration(a.claim_timeout),
            "done_timeout": duration(a.done_timeout), "resends": a.resends, "about": a.about, "skill": a.skill or ""}
    if a.recipe:
        body["recipe"] = json.load(open(a.recipe, encoding="utf-8"))
    elif a.check and a.prompt:
        body["check"] = open(a.check, encoding="utf-8").read()
        body["prompt"] = open(a.prompt, encoding="utf-8").read().strip()
        if not a.no_dry_run:
            run_check(body["check"], a.name)    # a check that does not run is not worth a human's look
    else:
        die("add needs --check and --prompt, or --recipe")
    board = Board(a.as_handle)
    if a.id:
        r = call("PATCH", f"/api/routines/{a.id}", body, board.token)
    else:
        r = call("POST", "/api/routines", {**body, "thread": a.thread}, board.token)
    print(f"routines: stored {r['name']} as routine {r['id']} (version {r['version']}), paused: {BOARD}/routines#r={r['id']}")


def main():
    p = argparse.ArgumentParser(prog="routines", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("run").add_argument("--interval", type=int, default=30)
    sub.add_parser("once")
    sub.add_parser("ls").add_argument("--as", dest="as_handle")
    c = sub.add_parser("check")
    c.add_argument("--as", dest="as_handle")
    c.add_argument("id", nargs="?", type=int)
    c.add_argument("--file")
    c.add_argument("--watermark")
    c = sub.add_parser("add")
    for flag in ("--name", "--channel"):
        c.add_argument(flag, required=True)
    c.add_argument("--check")
    c.add_argument("--prompt")
    c.add_argument("--recipe", help="a JSON recipe file instead of --check and --prompt")
    c.add_argument("--about", default="")
    c.add_argument("--every", default=str(DEFAULTS["every"]))
    c.add_argument("--claim-timeout", default=str(DEFAULTS["claim_timeout"]))
    c.add_argument("--done-timeout", default=str(DEFAULTS["done_timeout"]))
    c.add_argument("--resends", type=int, default=DEFAULTS["resends"])
    c.add_argument("--skill")
    c.add_argument("--thread", type=int)
    c.add_argument("--id", type=int)
    c.add_argument("--as", dest="as_handle")
    c.add_argument("--no-dry-run", action="store_true")
    a = p.parse_args()
    try:
        if a.cmd == "ls":
            cmd_ls(a)
        elif a.cmd == "check":
            cmd_check(a)
        elif a.cmd == "add":
            try:
                cmd_add(a)
            except CheckError as e:
                die(f"not posted, the check does not run: {e}")
        else:
            runner = Runner()
            while True:
                try:
                    runner.tick()
                except ConnectionError as e:
                    print(f"routines: board call failed, will retry: {e}", file=sys.stderr, flush=True)
                if a.cmd == "once":
                    break
                time.sleep(a.interval)
    except ConnectionError as e:
        die(str(e))
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
