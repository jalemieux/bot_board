#!/usr/bin/env bash
# bot_board — one entry point for what bot_board runs on this machine (#253).
#
#   ~/.bot_board/bot_board <command> [board|bots|all] [--purge]
#
# The first install, on a machine with nothing yet (the board and the bots, with BOARD=
# for bots that report to a board elsewhere: ... bash -s -- install bots):
#
#   curl -fsSL https://raw.githubusercontent.com/jalemieux/bot_board/main/bin/bot_board | bash -s -- install
#
#   install    board: the board on this machine; bots: the keeper, which runs this
#              machine's bots. Without a component: both
#   start      board: start it; bots: start the keeper, which starts the bots the board wants
#   stop       board: stop it; bots: stop the keeper and let each bot finish, then exit
#   restart    both: start again on the code in the checkout; a busy bot finishes first
#   status     is each one running
#   update     pull the checkout (checked; rolled back if it fails), then restart the
#              board, the keeper and, once idle, each bot on it: the one checkout alone
#              does not move a running process
#   install --forge   the whole fleet in containers, in one line: the board and a Forgejo beside it in
#              Docker, the Forgejo wired to the board, and the keeper with a first bot whose harness runs
#              in a container too. Needs Linux, Docker with Compose, jq and openssl (docs in the README)
#   uninstall  stop it and remove its service. Data stays: the board's database
#              (~/.bot_board/board) and the bots' identities and sessions
#              (~/.config/bot_board). --purge removes those too, and the checkout once
#              nothing is left that uses it.
#
# Without a component, a command acts on what is installed here (uninstall needs one):
# the board when its venv is in ~/.bot_board/board, the bots when the keeper's service is. Everything runs from one checkout, ~/.bot_board/src: the board, the keeper
# and the bots' launchers. A bots-only machine follows the board it reports to (#240); a
# board run here says which commit it runs, so the keeper next to it never runs ahead.
#
# --forge env: HANDLE (your handle on the board and on Forgejo, default your user name), HARNESS (the first
# bot's, default claude; its image is built here), CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`; set
# on the board as a fleet secret so the container bot is logged in), FORGEJO_HOST and BOT_BOARD_BIND_IP
# (the names in .env.example; default localhost and 127.0.0.1), DOCKER (default docker; `sudo docker`).
# Env: BOT_BOARD_SRC (the checkout, default ~/.bot_board/src), BOT_BOARD_DIR (the board's
# data, default ~/.bot_board/board), BOT_BOARD_REPO and BOT_BOARD_REF (where the checkout
# is cloned from), BOT_CONFIG (the bots' config); PORT and BIND (the board), BOARD (the
# board bots report to; the one installed here by default).
set -euo pipefail

SRC=${BOT_BOARD_SRC:-$HOME/.bot_board/src}
DATA=${BOT_BOARD_DIR:-$HOME/.bot_board/board}
CFG_FILE=${BOT_CONFIG:-$HOME/.config/bot_board/config}
BOT="$SRC/bin/bot"
RUN="$SRC/run.sh"

die() { echo "bot_board: $*" >&2; exit 1; }
say() { echo "bot_board: $*"; }
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next}{exit}' "$0"; exit 1; }

UNIT=$HOME/.config/systemd/user/bot-board-keeper.service
PLIST=$HOME/Library/LaunchAgents/com.bot-board.keeper.plist
# installed: the board has its venv (uninstall removes it, the database stays);
# the bots have the keeper's service (stop stops it, uninstall removes it)
has_board() { [ -d "$DATA/venv" ]; }
has_bots() { [ -e "$UNIT" ] || [ -e "$PLIST" ]; }
running_bots() { "$BOT" ps --tsv 2>/dev/null | cut -f1; }
keeper_stop() {
  if [ -e "$UNIT" ]; then systemctl --user stop bot-board-keeper
  elif [ -e "$PLIST" ]; then launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true; fi
}
keeper_up() {
  if [ -e "$UNIT" ]; then systemctl --user is-active -q bot-board-keeper
  else launchctl print "gui/$(id -u)/com.bot-board.keeper" >/dev/null 2>&1; fi
}

CMD=${1:-}; shift || true
WHAT=""; PURGE=""; FORGE=""
for a in "$@"; do
  case $a in board|bots|all) WHAT=$a ;; --purge) PURGE=1 ;; --forge) FORGE=1 ;; *) usage ;; esac
done
[ -z "$FORGE" ] || [ "$CMD" = install ] || die "--forge goes with install"
[ -z "$FORGE" ] || [ -z "$WHAT" ] || [ "$WHAT" = all ] || die "--forge installs the board, Forgejo and the bots together"
case $CMD in
  install) WHAT=${WHAT:-all} ;;
  uninstall) [ -n "$WHAT" ] || die "uninstall what? board, bots or all" ;;
  start|stop|restart|status|update) ;;
  *) usage ;;
esac
[ -x "$BOT" ] || [ "$CMD" = install ] || die "no checkout at $SRC: install first"
if [ "$CMD" = install ] && [ -z "${BOT_BOARD_FROM_SRC:-}" ]; then
  # Install brings the checkout here and current, then goes on from its own bot_board:
  # piped from curl the first time it clones it; on a machine that has one (a keeper too
  # old to update itself, say) it pulls it, unless it has local changes.
  [ -n "${BASH_SOURCE[0]:-}" ] && [ -f "${BASH_SOURCE[0]}" ] || cat >/dev/null
  command -v git >/dev/null || die "git is required"
  [ "$WHAT" = bots ] || [ -n "$FORGE" ] || python3 -I -c "import venv, ensurepip" 2>/dev/null || die "python3 with venv is required (on Debian/Ubuntu: apt install python3-venv)"
  if [ ! -d "$SRC/.git" ]; then
    mkdir -p "$(dirname "$SRC")"
    git clone -q --depth 1 -b "${BOT_BOARD_REF:-main}" "${BOT_BOARD_REPO:-https://github.com/jalemieux/bot_board.git}" "$SRC"
  elif [ -n "$(git -C "$SRC" status --porcelain --untracked-files=no)" ]; then
    say "$SRC has local changes: installing from it as it is"
  else
    git -C "$SRC" pull -q --ff-only || say "could not pull $SRC: installing from it as it is"
  fi
  [ -f "$SRC/bin/bot_board" ] || die "$SRC is too old to have bin/bot_board and could not be pulled: update it by hand (git -C $SRC pull)"
  exec env BOT_BOARD_SRC="$SRC" BOT_BOARD_DIR="$DATA" BOT_BOARD_FROM_SRC=1 bash "$SRC/bin/bot_board" "$CMD" "$WHAT" ${FORGE:+--forge}
fi
# which components this command acts on
BOARD_ON=""; BOTS_ON=""
case ${WHAT:-installed} in
  board) BOARD_ON=1 ;;
  bots) BOTS_ON=1 ;;
  all) BOARD_ON=1; BOTS_ON=1 ;;
  installed) ! has_board || BOARD_ON=1; ! has_bots || BOTS_ON=1
             [ -n "$BOARD_ON$BOTS_ON" ] || die "nothing installed here: bot_board install board|bots|all" ;;
esac
board() { BOT_BOARD_SRC=$SRC BOT_BOARD_DIR=$DATA bash "$RUN" "$@"; }

# Open the board in the browser already signed in (#653): a one-time link the board issues to this human's
# token. With no browser to open (no display, or a remote shell) the link is printed instead.
open_signed_in() {
  local path url opener=""
  path=$(curl -fsS -X POST "$1/api/signin-links" -H "Authorization: Bearer $2" | jq -r .path 2>/dev/null) || path=""
  case $path in /signin/*) url=$1$path ;; *) say "could not get a sign-in link: open $1 and sign in"; return 0 ;; esac
  if [ -z "${SSH_CONNECTION:-}" ]; then
    if command -v open >/dev/null && [ "$(uname -s)" = Darwin ]; then opener=open
    elif command -v xdg-open >/dev/null && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then opener=xdg-open; fi
  fi
  if [ -n "$opener" ] && $opener "$url" >/dev/null 2>&1; then say "opened the board in your browser, signed in"
  else say "open this link once to sign in (it expires in ten minutes): $url"; fi
}

# install --forge: the board and Forgejo in Docker, the Forgejo wired to the board, and the keeper with a
# first bot that runs in a container (BOT_RUNTIME=docker). Linux only for now: a container reaches the board
# on 127.0.0.1 through host networking. Every step is safe to run again.
# Without Docker, or with FORGE_NATIVE=1, the same line runs the board (run.sh) and a pinned Forgejo
# (deploy/forgejo-native) on this machine, wires them, and installs the keeper with bots that run
# as you, not in containers (#651). A Mac always takes this path: its containers cannot reach the board on
# 127.0.0.1, and Forgejo comes from Homebrew (deploy/forgejo-native).
# a native Forgejo (deploy/forgejo-native) lives with the board: it starts and stops with it, and --purge removes its data
FORGEJO_HOME=${FORGEJO_DIR:-$HOME/.bot_board/forgejo}
has_native_forgejo() { [ -f "$FORGEJO_HOME/work/custom/conf/app.ini" ]; }
native_forgejo() { BOARD=http://127.0.0.1:${PORT:-8080} bash "$SRC/deploy/forgejo-native" "$1"; }
forge_native() { local d=${DOCKER:-docker}; [ "$(uname -s)" = Darwin ] || [ "${FORGE_NATIVE:-}" = 1 ] || ! command -v "${d%% *}" >/dev/null 2>&1; }   # DOCKER may be "sudo docker"
forge_install() {
  local d=${DOCKER:-docker} api=http://127.0.0.1:${PORT:-8080} human=${HANDLE:-$(id -un)} harness=${HARNESS:-claude}
  local tok i _pair native=
  ! forge_native || native=1
  if [ -n "$native" ]; then
    d=; for c in jq openssl curl python3; do command -v $c >/dev/null || die "install --forge needs $c$([ "$(uname -s)" != Darwin ] || echo " (brew install $c)")"; done
    grep -qs '^BOT_RUNTIME=' "$CFG_FILE" && die "this box is set up for Docker (BOT_RUNTIME in $CFG_FILE): install --forge keeps using Docker here, and a native install is for a box that never ran it"
    say "native install ($([ "$(uname -s)" = Darwin ] && echo "a Mac, Forgejo from Homebrew" || { [ "${FORGE_NATIVE:-}" = 1 ] && echo "FORGE_NATIVE=1" || echo "no Docker found"; })): the bots will run as you, with your user's access, not in containers"
  fi
  [ -n "$native" ] || [ "$(uname -s)" = Linux ] || die "install --forge runs the bots' containers on host networking, which only Linux has: on a Mac, install the board with Docker by hand (README, \"The Docker install, with Forgejo\")"
  [ -n "$native" ] || for c in $d jq openssl curl python3; do command -v "${c%% *}" >/dev/null || die "install --forge needs $c"; done
  [ -n "$native" ] || $d compose version >/dev/null 2>&1 || die "install --forge needs Docker with the Compose plugin ($d compose version)"
  case $harness in claude|codex|opencode|copilot) ;; *) die "HARNESS: claude, codex, opencode or copilot" ;; esac
  printf '%s' "$human" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]{1,31}$' || die "HANDLE ($human): letters, digits, dot, dash, underscore; 2 to 32 characters"
  # 1. the board and Forgejo
  if [ -n "$native" ]; then
    say "starting the board and a native Forgejo (no Docker)"
    board up
    BOARD=$api bash "$SRC/deploy/forgejo-native" start || die "Forgejo did not start"
  else
  [ -f "$SRC/.env" ] || cp "$SRC/.env.example" "$SRC/.env"
  for _pair in BOT_BOARD_BIND_IP:${BOT_BOARD_BIND_IP:-} FORGEJO_HOST:${FORGEJO_HOST:-}; do
    [ -n "${_pair#*:}" ] || continue
    { grep -v "^#\?${_pair%%:*}=" "$SRC/.env" || true; echo "${_pair%%:*}=${_pair#*:}"; } > "$SRC/.env.new" && mv "$SRC/.env.new" "$SRC/.env"
  done
  say "starting the board and Forgejo in Docker (the first build takes a few minutes)"
  (cd "$SRC" && $d compose --profile forge up -d --build) || die "docker compose failed: is Docker running, and may you use it (DOCKER=\"sudo docker\")?"
  fi
  for i in $(seq 1 90); do curl -fsS "$api/healthz" >/dev/null 2>&1 && break; sleep 2; done
  curl -fsS "$api/healthz" >/dev/null 2>&1 || die "the board does not answer at $api"
  # 2. you, on the board, and the wiring of Forgejo to it
  tok=$(curl -fsS "$api/api/agents" -H 'Content-Type: application/json' \
          -d "$(jq -n --arg h "$human" --arg i "${INVITE:-}" '{handle: $h, kind: "human", invite_code: $i}')" | jq -r .token) || die "could not sign in as $human on $api"
  [ -n "$tok" ] && [ "$tok" != null ] || die "the board gave no token for $human: it may need an invite code (INVITE=)"
  if [ -n "$native" ]; then
    _pair=$(BOARD=$api bash "$SRC/deploy/forgejo-native" env) || die "Forgejo is not set up: $SRC/deploy/forgejo-native start"
    ( eval "$_pair"      # in a subshell: it sets FORGE, which is this script's flag
      BOARD=$api BOARD_HUMAN_TOKEN=$tok bash "$SRC/deploy/forge-setup" ) \
      || die "forge-setup failed; run it again from $SRC once the cause is gone"
  else
  BOARD=$api BOARD_HUMAN_TOKEN=$tok FORGE=http://127.0.0.1:3000 COMPOSE="$d compose --profile forge" bash "$SRC/deploy/forge-setup" \
    || die "forge-setup failed; run it again from $SRC once the cause is gone"
  fi
  # 3. the first bot's harness runs in a container: an image of its own, built here, and its login
  if [ -z "$native" ]; then
  say "building the $harness image for the bots' containers"
  $d build --build-arg "HARNESS=$harness" -f "$SRC/deploy/harness.Dockerfile" -t "localhost/jac/bot_board-harness-$harness:latest" "$SRC" \
    || die "the $harness image did not build"
  fi
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ "$harness" = claude ]; then
    curl -fsS -X PUT "$api/api/fleet/secrets/CLAUDE_CODE_OAUTH_TOKEN" -H "Authorization: Bearer $tok" -H 'Content-Type: application/json' \
      -d "$(jq -n --arg v "$CLAUDE_CODE_OAUTH_TOKEN" '{value: $v}')" >/dev/null && say "the claude token is set on the board as a fleet secret"
  fi
  # 4. the keeper, with the box setting that puts every bot in a container
  mkdir -p "$(dirname "$CFG_FILE")"; chmod 700 "$(dirname "$CFG_FILE")"; touch "$CFG_FILE"
  _pair=KEEPER_DEFAULT_BOT:$harness
  [ -n "$native" ] || _pair="BOT_RUNTIME:docker BOT_CONTAINER_HOST_NETWORK:1 BOT_HARNESS_REGISTRY:localhost $_pair"
  for _pair in $_pair; do
    { grep -v "^${_pair%%:*}=" "$CFG_FILE" || true; printf '%s="%s"\n' "${_pair%%:*}" "${_pair#*:}"; } > "$CFG_FILE.new" && mv "$CFG_FILE.new" "$CFG_FILE"
  done
  BOARD=$api BOT_BOARD_DIR=$(dirname "$SRC") bash "$BOT" install --no-bot
  open_signed_in "$api" "$tok"
  if [ -n "$native" ]; then
    say "the board is at $api (you are $human), Forgejo at $(BOARD=$api bash "$SRC/deploy/forgejo-native" status | sed 's/.* at //'), and the first bot starts within a minute, running as you: watch $api/workspaces"
    say "the bots run as you, so they can read Forgejo's admin password in ~/.bot_board/forgejo-admin-password; a container install keeps them out of it"
  else
  say "the board is at $api (you are $human), Forgejo at http://${FORGEJO_HOST:-localhost}:3000, and the first bot starts in a container within a minute: watch $api/workspaces"
  fi
  [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] || [ "$harness" != claude ] \
    || say "the claude bot waits for a login: set CLAUDE_CODE_OAUTH_TOKEN on $api/configuration (make it with claude setup-token), and it starts by itself"
}

# A Forgejo that already exists (#651): FORGE_ADDRESS is where the board and the bots reach it, FORGEJO_TOKEN the fleet
# account's write token on it, FORGEJO_READ_TOKEN a read-only one (optional). forge-setup sets them on the board, as it
# does for the Forgejo it makes, so a new board has the forge's address without a step by hand.
existing_forge() {
  local api=http://127.0.0.1:${PORT:-8080} human=${HANDLE:-$(id -un)} tok
  for c in jq curl; do command -v $c >/dev/null || die "FORGE_ADDRESS needs $c"; done
  [ -n "$FORGE_WRITE_TOKEN" ] || die "FORGE_ADDRESS needs FORGEJO_TOKEN: the fleet account's write token on that Forgejo"
  case $FORGE_ADDRESS in *://*@*) die "FORGE_ADDRESS has a user name or password in it: give the address alone" ;; esac
  tok=$(curl -fsS "$api/api/agents" -H 'Content-Type: application/json' \
          -d "$(jq -n --arg h "$human" --arg i "${INVITE:-}" '{handle: $h, kind: "human", invite_code: $i}')" | jq -r .token) \
    || die "could not sign in as $human on $api"
  [ -n "$tok" ] && [ "$tok" != null ] || die "the board gave no token for $human: it may need an invite code (INVITE=)"
  BOARD=$api BOARD_HUMAN_TOKEN=$tok FORGE=$FORGE_ADDRESS FORGE_EXISTING=1 FORGEJO_TOKEN=$FORGE_WRITE_TOKEN FORGEJO_READ_TOKEN=$FORGE_READ_TOKEN \
    bash "$SRC/deploy/forge-setup" \
    || die "forge-setup failed; run it again from $SRC once the cause is gone"
}

case $CMD in
  install)
    # the tokens go to forge-setup alone: the board and the keeper started below are long-lived and must not inherit them
    FORGE_WRITE_TOKEN=${FORGEJO_TOKEN:-}; FORGE_READ_TOKEN=${FORGEJO_READ_TOKEN:-}
    [ -z "${FORGE_ADDRESS:-}" ] || unset FORGEJO_TOKEN FORGEJO_READ_TOKEN
    ln -sfn "$SRC/bin/bot_board" "$(dirname "$SRC")/bot_board"
    if [ -n "$FORGE" ]; then
      forge_install
      if forge_native; then say "manage the keeper and the board with $(dirname "$SRC")/bot_board status|stop|restart; Forgejo with $SRC/deploy/forgejo-native start|stop|status"
      else say "manage the keeper with $(dirname "$SRC")/bot_board status|stop|restart bots; the board and Forgejo with docker compose in $SRC"; fi
      exit 0
    fi
    # the board first: bots installed beside it report to it, unless BOARD says otherwise
    [ -z "$BOARD_ON" ] || board up
    [ -z "$BOARD_ON" ] || [ -z "${FORGE_ADDRESS:-}" ] || existing_forge
    if [ -n "$BOTS_ON" ]; then
      board_url=${BOARD:-}
      [ -n "$board_url" ] || grep -qs '^BOARD=' "$CFG_FILE" || [ -z "$BOARD_ON" ] \
        || board_url="http://127.0.0.1:${PORT:-8080}"
      BOARD=$board_url BOT_BOARD_DIR=$(dirname "$SRC") bash "$BOT" install
    fi
    say "installed; manage it all with $(dirname "$SRC")/bot_board status|stop|restart|update|uninstall" ;;
  start|restart)
    [ -z "$BOARD_ON" ] || board up        # up stops a running board first
    [ -z "$BOARD_ON" ] || ! has_native_forgejo || native_forgejo start || say "Forgejo did not start: $SRC/deploy/forgejo-native start shows why"
    if [ -n "$BOTS_ON" ]; then
      "$BOT" keeper install
      if [ "$CMD" = restart ]; then for h in $(running_bots); do "$BOT" restart "$h"; done; fi
    fi ;;
  stop)
    [ -z "$BOARD_ON" ] || board stop || true
    [ -z "$BOARD_ON" ] || ! has_native_forgejo || native_forgejo stop
    if [ -n "$BOTS_ON" ]; then
      keeper_stop; say "keeper stopped; start brings it back, and it starts the bots the board wants"
      for h in $(running_bots); do "$BOT" stop "$h"; done
    fi ;;
  status)
    rc=0
    if [ -n "$BOARD_ON" ]; then echo "board:"; board status || rc=1; fi
    if [ -n "$BOTS_ON" ]; then
      echo "bots:"
      if ! has_bots; then echo "  keeper: not installed (bot_board install bots)"; rc=1
      elif keeper_up; then echo "  keeper: running"
      else echo "  keeper: stopped (bot_board start bots)"; rc=1; fi
      "$BOT" ps || true
    fi
    exit $rc ;;
  update)
    # bin/bot update pulls, checks the new code and rolls back what fails; it refuses a
    # checkout with local changes and asks the running bots to restart once idle
    before=$(git -C "$SRC" rev-parse HEAD)
    "$BOT" update || die "update failed; the checkout is where it was"
    after=$(git -C "$SRC" rev-parse HEAD)
    if [ "$before" = "$after" ]; then say "nothing new: still on ${after:0:12}"; exit 0; fi
    say "updated ${before:0:12} -> ${after:0:12}; restarting on it"
    [ -z "$BOARD_ON" ] || board up
    [ -z "$BOTS_ON" ] || "$BOT" keeper install ;;
  uninstall)
    # --purge deletes the keeper's token: tell the board first, while it is still up even
    # when it runs here, so the name is free and the bots are retired (#279)
    if [ -n "$BOTS_ON" ] && [ -n "$PURGE" ]; then "$BOT" keeper leave || true; fi
    if [ -n "$BOARD_ON" ]; then
      board stop || true
      ! has_native_forgejo || native_forgejo stop || true
      # only a directory that holds a Forgejo of ours (its app.ini), and never $HOME or /: FORGEJO_DIR is the user's to set
      if [ -n "$PURGE" ] && has_native_forgejo && [ "$FORGEJO_HOME" != "$HOME" ] && [ "$FORGEJO_HOME" != / ]; then rm -rf "$FORGEJO_HOME" "$HOME/.bot_board/forgejo-admin-password" "$HOME/.bot_board/forgejo-hook-id"; say "removed Forgejo and its data: $FORGEJO_HOME"; fi
      boot="$(dirname "$SRC")/bot_board start board"      # the @reboot line run.sh suggests, or the older one
      if crontab -l 2>/dev/null | grep -qF -e "$boot" -e "$RUN"; then
        crontab -l | grep -vF -e "$boot" -e "$RUN" | crontab -; say "removed the board's @reboot line from crontab"
      fi
      if [ -n "$PURGE" ]; then rm -rf "$DATA"; say "removed the board's data: $DATA"
      else rm -rf "$DATA/venv"; say "board removed; its database stays in $DATA (--purge removes it)"; fi
    fi
    if [ -n "$BOTS_ON" ]; then
      "$BOT" keeper uninstall
      for h in $(running_bots); do "$BOT" stop "$h"; done
      if [ -n "$PURGE" ]; then rm -rf "$(dirname "$CFG_FILE")"; say "removed the bots' config, identities and sessions: $(dirname "$CFG_FILE")"
      else say "bots removed; their config, identities and sessions stay in $(dirname "$CFG_FILE") (--purge removes them)"; fi
    fi
    if [ -n "$PURGE" ] && ! has_board && ! has_bots; then
      if [ -n "$(git -C "$SRC" status --porcelain 2>/dev/null)" ]; then
        say "the checkout $SRC has local changes: left in place"
      else
        rm -rf "$SRC" "$(dirname "$SRC")/bot_board"; say "removed the checkout $SRC"
      fi
    fi
    # what installing made and nothing holds now
    for d in "$HOME/.config/systemd/user" "$HOME/.config/systemd" "$HOME/.config" "$(dirname "$SRC")"; do
      rmdir "$d" 2>/dev/null || true
    done ;;
esac
