#!/usr/bin/env python3
"""keeper — the one thing a box runs so the board can see it and run bots on it.

  keeper install                install it as a service of this user and start it (no sudo); the way to set up a box
  keeper uninstall              stop and remove that service; bots already running stay up
  keeper run [--interval 15]    the keeper itself, in the foreground
  keeper once                   one report and one round of what the board asks, then exit
  keeper show                   print what would be reported; sends nothing, does nothing

The board cannot look at a box or act on one, so each box has a keeper that
does both. Every few seconds it tells the board how many cores, the load, the
memory left, and every bot bin/bot knows here with what it is doing; the fleet
page (/fleet) and GET /api/fleet show the last report from each box.

With each report the board hands back what a human asked for on this box: this
bot running, that one stopped. The keeper makes it so with bin/bot. Asked to
run and not running: it starts the bot (bin/bot <harness> --name <handle>, a new
bot when the name is new here) and starts it again if it dies. Asked to stop:
bin/bot stop, which lets the run in progress finish. Those are the only two
things it does, and the harness and handle are checked before either. A bot that
will not stay up is reported with the reason and left alone until someone asks
again. Bots nobody asked about on the board are reported and never touched.

When the bots here say their harness is logged out (Claude Code, Codex), the
keeper starts that login itself and sends the link to the operators in a
conversation on the board (keeper-<name> and KEEPER_OPERATORS, else the board's
humans): no ssh to the box needed. Codex shows a code to type on the page and
finishes by itself; for Claude the operator replies with the code the page
shows, and the keeper feeds it to the login and removes that reply from the
board. One alert per outage; a link that runs out gets a new one in a reply.

A human can also move a pool bot to another box from the page. Its keeper stops
it, packs it (bin/bot pack: token, state, Claude Code sessions) and copies the
archive to KEEPER_HANDOVER, a private directory on one box every box reaches by
ssh, written host:dir (dir under that box's home) and set the same on every box;
on that box itself it is a plain directory. The board then points the bot at
the new box, whose keeper copies the archive back, unpacks it into its own
BOT_POOL, deletes the copy, and starts the bot under the same handle. The
archive holds the bot's token, which is why it goes over ssh and never through
the board. A move needs ssh without a password from both boxes to that one.

Bots are started with the keeper's environment, so `claude` (or the harness you
use) must be on the PATH the keeper has; `keeper install` records the PATH of
the shell it is run from. What a started bot prints goes to
~/.config/bot_board/bots/<handle>/keeper.out.

The box reports under its name on the tailnet when tailscale is there (the name
other boxes can reach it by), else its hostname; KEEPER_HOST overrides both. It
registers on the board as keeper-<name> and keeps that token with the bots'
tokens, in ~/.config/bot_board/. The first keeper to report a name owns it.

Before it starts a bot the keeper checks what the bot's harness needs, and holds
the start while something is missing: the bot is reported "held: claude not
logged in" and started on its own once a check passes again (checks run every
5 minutes). Two kinds. A login (Claude Code /login, codex login) is interactive
and belongs to this box, so it is only checked; someone logs in here. A secret
(GH_TOKEN) is a plain long-lived string, kept in one file, fleet.env (KEY=value
lines, mode 600), in ~/.config/bot_board on the hand-over box. Every keeper
copies it over the ssh it already uses for moves, at start and every 5 minutes,
to ~/.config/bot_board/fleet.env here, and starts bots with it in their
environment, so rotating a token is editing that one file. Never through the
board. KEEPER_FLEET_ENV=host:path names another place for it. Each
credential's state goes out with the report and shows on /fleet; nothing about
it is ever posted to a channel.

Env: BOARD and BOT_INVITE (also read from ~/.config/bot_board/config), KEEPER_HOST,
KEEPER_OPERATORS (handles, space or comma separated: only what they asked is carried
out; unset, anyone the board accepted as a human), KEEPER_HANDOVER (where archives of
moving bots wait: host:dir, e.g. minipc-1:.config/bot_board/handover).
"""
import argparse, fcntl, json, os, platform, re, shlex, shutil, socket, subprocess, sys, time, urllib.error, urllib.request
from datetime import datetime, timezone
from pathlib import Path

CFG = os.path.expanduser("~/.config/bot_board")
BOT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bot")


def die(msg):
    sys.exit(f"keeper: {msg}")


def setting(name, default=""):
    """The environment, else a plain NAME=value line in the config bin/bot reads."""
    if os.environ.get(name):
        return os.environ[name]
    try:
        for line in open(os.environ.get("BOT_CONFIG") or os.path.join(CFG, "config"), encoding="utf-8"):
            m = re.match(rf"\s*(?:export\s+)?{name}=(.*)$", line)
            if m:   # a shell file: quotes, and a comment after the value
                return "".join(shlex.split(m.group(1), comments=True)[:1])
    except OSError:
        pass
    return default


BOARD = setting("BOARD", "http://127.0.0.1:8080").rstrip("/")
OPERATORS = setting("KEEPER_OPERATORS").replace(",", " ").split()
HARNESSES = ("claude", "codex", "opencode", "copilot")
HANDLE_RE = re.compile(r"[a-z0-9][a-z0-9._-]{1,31}", re.I)
QUICK = 120     # a bot that dies this soon after we start it has a problem; later, it is restarted
HANDOVER = setting("KEEPER_HANDOVER")
SSH = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=15"]


def out(*cmd):
    """A command's stdout, or "" when it is missing or fails."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def host_name():
    name = setting("KEEPER_HOST")
    if not name:
        # the Mac app does not put its CLI on PATH
        ts = shutil.which("tailscale") or "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
        try:
            name = json.loads(out(ts, "status", "--json"))["Self"]["DNSName"].split(".")[0]
        except (ValueError, KeyError, IndexError):
            name = platform.node().split(".")[0]
    name = re.sub(r"[^a-z0-9._-]", "-", name.lower()).strip("-.")
    return name if len(name) >= 2 else die("cannot work out a name for this box; set KEEPER_HOST")


def memory_mb():
    """(total, available to new work), None for what this OS does not tell us."""
    try:
        if sys.platform.startswith("linux"):
            kb = dict(re.findall(r"^(\w+):\s+(\d+) kB", open("/proc/meminfo").read(), re.M))
            return int(kb["MemTotal"]) // 1024, int(kb["MemAvailable"]) // 1024
        if sys.platform == "darwin":
            total = int(out("sysctl", "-n", "hw.memsize")) // 2**20
            vm = out("vm_stat")
            page = int(re.search(r"page size of (\d+) bytes", vm).group(1))
            pages = {k: int(v) for k, v in re.findall(r"^Pages ([\w ]+):\s+(\d+)\.", vm, re.M)}
            return total, (pages["free"] + pages["inactive"] + pages.get("speculative", 0)) * page // 2**20
    except (OSError, ValueError, KeyError, AttributeError):
        pass
    return None, None


def bots():
    rows = []
    for line in out(BOT, "ps", "-a", "--tsv").splitlines():
        handle, harness, status, _pid, _seen, serves, health = (line.split("\t") + [""] * 7)[:7]
        # bin/bot rewrites a bot's run counter as each harness run ends
        try:
            ran = datetime.fromtimestamp(os.path.getmtime(os.path.join(CFG, "bots", handle, "runs")), timezone.utc)
        except OSError:
            ran = None
        rows.append({"handle": handle, "harness": "" if harness == "?" else harness, "status": status,
                     "serves": "" if serves == "?" else serves,
                     "pool": os.path.exists(os.path.join(CFG, "bots", handle, "pool")),
                     "last_run": ran.isoformat(timespec="seconds") if ran else "",
                     "health": health.strip()})
    return rows


def snapshot():
    total, free = memory_mb()
    try:
        load = round(os.getloadavg()[0], 2)
    except OSError:
        load = None
    return {"cores": os.cpu_count(), "load": load, "mem_total_mb": total, "mem_free_mb": free,
            "os": f"{platform.system()} {platform.release()}"[:80], "bots": bots()}


class Handover:
    """KEEPER_HANDOVER: host:dir reached by ssh, or a directory here when the host is this box."""

    def __init__(self, me, spec=None):
        spec = HANDOVER if spec is None else spec
        m = re.match(r"([^/:]+):(.*)$", spec)
        self.host, path = (m.group(1), m.group(2)) if m else ("", spec)
        if self.host and self.is_me(self.host, me):
            self.host = ""      # the hand-over box is this one: no ssh to ourselves
        # the path is under the home directory either way; a ~/ in front would be quoted
        # into a directory named ~ by the remote mkdir, while scp expands it
        path = re.sub(r"^~/?", "", path.rstrip("/"))
        self.dir = path or ".config/bot_board/handover"
        if not self.host:
            self.dir = os.path.join(os.path.expanduser("~"), self.dir)

    @staticmethod
    def is_me(host, me):
        """This box, by its keeper name, or by any address it resolves to that is ours:
        localhost, the tailnet IP, another name for the same box."""
        host = host.split("@")[-1]
        if host.split(".")[0].lower() == me:
            return True
        try:
            addrs = {a[4][0] for a in socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)}
        except OSError:
            return False
        for ip in addrs:
            fam = socket.AF_INET6 if ":" in ip else socket.AF_INET
            try:
                with socket.socket(fam, socket.SOCK_DGRAM) as sk:
                    sk.bind((ip, 0))    # only an address of this box can be bound
                return True
            except OSError:
                continue
        return False

    def run(self, *cmd):
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
        if r.returncode:
            err = " ".join((r.stderr or r.stdout).split())
            raise RuntimeError(err[-400:] or f"{cmd[0]} exited {r.returncode}")

    def put(self, local, name):
        if self.host:
            self.run("ssh", *SSH, self.host, f"mkdir -p -m 700 {shlex.quote(self.dir)}")
            self.run("scp", "-q", *SSH, local, f"{self.host}:{self.dir}/{name}")
        else:
            os.makedirs(self.dir, mode=0o700, exist_ok=True)
            shutil.copy(local, os.path.join(self.dir, name))

    def get(self, name, local):
        if self.host:
            self.run("scp", "-q", *SSH, f"{self.host}:{self.dir}/{name}", local)
        else:
            shutil.copy(os.path.join(self.dir, name), local)

    def drop(self, name):
        if self.host:
            self.run("ssh", *SSH, self.host, f"rm -f {shlex.quote(self.dir + '/' + name)}")
        else:
            try:
                os.remove(os.path.join(self.dir, name))
            except FileNotFoundError:
                pass


# What a box needs before it starts a bot. name, kind, the env var a secret is kept in,
# the command that checks it, and the harnesses whose bots are held while it fails.
CREDENTIALS = (
    ("gh", "secret", "GH_TOKEN", ("gh", "auth", "status"), ()),     # reported; a bot without gh can still answer
    ("claude", "login", "", ("claude", "auth", "status"), ("claude",)),
    ("codex", "login", "", ("codex", "login", "status"), ("codex",)),
)
CHECK_EVERY = 300
FLEET_ENV = os.path.join(CFG, "fleet.env")


SECRET_NAME = re.compile(r"[A-Z][A-Z0-9_]*_(?:TOKEN|KEY|SECRET)")   # what fleet.env may set; bin/bot reads the same


def read_env(path):
    """The secrets in fleet.env: KEY=value lines (export, quotes and comments allowed), read
    literally, never run, and only names SECRET_NAME allows, so it cannot move BOARD or PATH."""
    env = {}
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return env
    for line in lines:
        m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
        if m:
            try:
                if SECRET_NAME.fullmatch(m.group(1)):
                    env[m.group(1)] = "".join(shlex.split(m.group(2), comments=True)[:1])
            except ValueError:
                pass
    return env


class Credentials:
    """Checks what bots need on this box, and keeps fleet.env in step with the central copy."""

    def __init__(self, me):
        self.me = me
        self.state = {}         # name -> (state, detail)
        self.checked = 0        # when the checks last ran
        self.sync_error = ""
        spec = setting("KEEPER_FLEET_ENV")
        if not spec and HANDOVER:
            ho = Handover(me)
            spec = f"{ho.host}:.config/bot_board/fleet.env" if ho.host else ""   # the hand-over box is this one
        self.source = spec      # host:path, or "" when fleet.env is kept here by hand

    def sync(self):
        """Copy fleet.env from its central place when it differs from ours. Errors keep our copy."""
        if not self.source:
            return
        d, name = os.path.split(self.source)
        tmp = FLEET_ENV + ".new"
        try:
            Handover(self.me, d).get(name or "fleet.env", tmp)
            os.chmod(tmp, 0o600)
            if not os.path.exists(FLEET_ENV) or Path(FLEET_ENV).read_bytes() != Path(tmp).read_bytes():
                os.replace(tmp, FLEET_ENV)
                print(f"keeper: fleet.env updated from {self.source}", flush=True)
            self.sync_error = ""
        except (OSError, RuntimeError, subprocess.SubprocessError) as e:
            self.sync_error = f"fleet.env not copied from {self.source}: {str(e)[:200]}"
        finally:
            if os.path.exists(tmp):
                os.remove(tmp)

    def env(self):
        """The environment bots are started with: fleet.env's secrets under the keeper's own
        environment, which wins (as it does in bin/bot)."""
        return {**read_env(FLEET_ENV), **os.environ}

    def needed(self, harnesses):
        return [c for c in CREDENTIALS if c[1] == "secret" or set(c[4]) & set(harnesses)]

    def check(self, cred, env):
        name, kind, var, cmd, _ = cred
        if not shutil.which(cmd[0], path=env.get("PATH")):
            return "missing", f"{cmd[0]} is not installed (or not on the keeper's PATH)"
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=30, env=env, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError) as e:
            return "unknown", f"check failed: {e}"[:200]
        said = " ".join((r.stdout + " " + r.stderr).split())[:200]
        # Only a definite answer counts. Anything else (an older CLI, a timeout, words we do
        # not know) is "unknown", which is reported and holds nothing: as with bin/bot since
        # #70, a hiccup in the check must not stop every bot on the box.
        if name == "claude":
            try:
                logged = json.loads(r.stdout).get("loggedIn")
            except (ValueError, AttributeError):
                logged = None
            if logged is True:
                return "ok", ""
            if logged is False:
                return "missing", "not logged in"
            return "unknown", f"could not read `{' '.join(cmd)}`: {said}"[:200]
        if r.returncode == 0:
            return "ok", ""
        if kind == "secret" and env.get(var) and re.search(r"invalid|expired|revoked|bad credentials|401", said, re.I):
            return "expired", f"{var} is set but refused: {said}"[:200]
        if re.search(r"not logged in|no.{0,20}(login|credential|token)|log ?in (first|required)", said, re.I):
            return "missing", (f"no {var} (fleet.env) and no login" if kind == "secret" else "not logged in")
        return "unknown", f"`{' '.join(cmd)}` exited {r.returncode}: {said}"[:200]

    def refresh(self, harnesses, force=False, sync=True):
        """Run the checks when they are due, or at once when a harness is new to them."""
        need = self.needed(harnesses)
        if not force and time.time() - self.checked < CHECK_EVERY and all(c[0] in self.state for c in need):
            return
        if sync:
            self.sync()
        env = self.env()
        self.state = {c[0]: self.check(c, env) for c in need}
        self.checked = time.time()

    def blocked(self):
        """harness -> why its bots are not started."""
        out = {}
        for name, _, _, _, holds in CREDENTIALS:
            st, why = self.state.get(name, ("ok", ""))
            for hn in holds if st == "missing" else ():   # "unknown" and "expired" hold nothing
                out[hn] = f"{name} {why or st}"
        return out

    def report(self, held):
        """[{name, kind, state, detail, held}] for /fleet; held: harness -> bots it holds."""
        rows = [{"name": c[0], "kind": c[1], "state": self.state[c[0]][0], "detail": self.state[c[0]][1],
                 "held": sum(held.get(hn, 0) for hn in c[4])} for c in CREDENTIALS if c[0] in self.state]
        if self.sync_error:
            rows.append({"name": "fleet.env", "kind": "secret", "state": "stale", "detail": self.sync_error, "held": 0})
        return rows


class Hands:
    """Makes the box match what the board asks. Remembers, for this run of the keeper,
    when it started each bot and which requests it gave up on."""

    def __init__(self, me=""):
        self.me = me
        self.handed = {}        # handle -> archive: packed and handed over, for the next report
        self.fetched = []       # unpacked after a move, for the next report
        # hand-over copies already unpacked here that could not be deleted yet; they hold
        # a token, so they are retried until they go, across restarts of the keeper
        self.drops_file = os.path.join(CFG, "handover-drops")
        self.started = {}       # handle -> (when we last started it, the set_at of the request)
        self.gave_up = {}       # handle -> (the set_at of the request that failed, why)
        self.procs = {}         # handle -> the bin/bot we started for it, which is the bot for as long as it lives
        self.killed = {}        # handle -> the kill request (its time) already carried out
        self.blocked = {}       # harness -> why its bots are not started now (Credentials.blocked)
        self.held = {}          # harness -> how many bots that held in the last round
        self.env = None         # the environment bots start with (None: the keeper's own)

    def reconcile(self, want, seen):
        """want: the board's rows for this box. seen: bin/bot ps. Returns handle -> problem."""
        up = {b["handle"].lower(): b["status"] for b in seen if b["status"].startswith(("waiting", "running"))}
        here = {b["handle"].lower() for b in seen if b["status"] != "moved"}
        problems = {}
        self.held = {}
        self.retry_drops()
        for w in want:
            h = w["handle"]
            if not HANDLE_RE.fullmatch(h) or w["harness"] not in HARNESSES:
                problems[h] = "not carried out: not a handle and harness this keeper accepts"
            elif OPERATORS and w["set_by"] not in OPERATORS:
                problems[h] = f"not carried out: @{w['set_by']} is not an operator of this box (KEEPER_OPERATORS)"
            elif w.get("move_to"):
                why = self.leave(w, up, seen)
                if why:
                    problems[h] = why
            elif w.get("fetch") and h.lower() not in here:
                why = self.arrive(w)    # started on the next round, like any bot asked to run
                if why:
                    problems[h] = why
            elif w.get("fetch") and h not in self.fetched:
                # unpacked already (by this keeper before a restart, or the report was lost):
                # tell the board, and make sure the hand-over copy goes
                self.fetched.append(h)
                self.queue_drop(w["fetch"])
            elif not w["run"]:
                # a kill goes ahead even when a stop is already waiting on the run: that run is what is stuck
                if h.lower() in up and w.get("kill") and self.killed.get(h) != w["kill"]:
                    self.killed[h] = w["kill"]
                    self.spawn(h, [BOT, "kill", h])
                    print(f"keeper: killing {h}, asked by @{w['set_by']}", flush=True)
                elif h.lower() in up and "stopping" not in up[h.lower()] and not w.get("kill"):
                    self.spawn(h, [BOT, "stop", h])
                    print(f"keeper: stopping {h}, asked by @{w['set_by']}", flush=True)
            elif h.lower() in up:
                self.gave_up.pop(h, None)   # it came up after all: if it dies later, that is a new story
            else:
                when, asked = self.started.get(h, (0, None))
                proc = self.procs.get(h)
                starting = proc and proc.poll() is None
                if not starting and w["harness"] in self.blocked:
                    # nothing to start it with: say so, and start it once the check passes
                    problems[h] = f"held: {self.blocked[w['harness']]}"
                    self.held[w["harness"]] = self.held.get(w["harness"], 0) + 1
                    # what it did without a login is not held against it: once the check passes, it starts
                    self.gave_up.pop(h, None); self.started.pop(h, None)
                elif starting:
                    # Our bin/bot is alive and not in `bot ps` yet: it is equipping skills or
                    # registering. Never start a second one beside it.
                    if time.time() - when > QUICK:
                        problems[h] = f"still starting after {int(time.time() - when) // 60} min: {self.last_words(h)}"
                elif self.gave_up.get(h, ("",))[0] == w["set_at"]:
                    problems[h] = self.gave_up[h][1]
                elif asked == w["set_at"] and time.time() - when < QUICK:
                    why = f"started and did not stay up: {self.last_words(h)}"
                    self.gave_up[h] = (w["set_at"], why)
                    problems[h] = why
                    print(f"keeper: {h} {why}", flush=True)
                else:   # a new request, or a bot that ran a while and died: start it
                    self.started[h] = (time.time(), w["set_at"])
                    self.procs[h] = self.spawn(h, [BOT, w["harness"], "--name", h])
                    print(f"keeper: starting {h} ({w['harness']}), asked by @{w['set_by']}", flush=True)
        return problems

    def leave(self, w, up, seen):
        """A bot asked to move away: stop it, then pack it and hand the archive over.
        Returns None while that goes well, else why not."""
        h = w["handle"]
        if h in self.handed:
            return None         # done; the board learns it with this report
        mark = os.path.join(CFG, "bots", h, "handed")
        if os.path.exists(mark):
            # handed over before this keeper restarted: report that, never pack a second copy
            self.handed[h] = open(mark).read().strip()
            return None
        if not HANDOVER:
            return f"not moved: set KEEPER_HANDOVER on this box (where archives wait, e.g. minipc-1:.config/bot_board/handover)"
        if h.lower() in up:
            if "stopping" not in up[h.lower()]:
                self.spawn(h, [BOT, "stop", h])
                print(f"keeper: stopping {h} to move it to {w['move_to']}, asked by @{w['set_by']}", flush=True)
            return None
        if not os.path.exists(os.path.join(CFG, "bots", h, "pool")):
            return "not moved: only pool bots move from the board"
        name = f"{h}-{os.urandom(4).hex()}.botpack.tgz"
        tmp = os.path.join(CFG, "bots", h + ".botpack.tgz")
        packed = False
        try:
            r = subprocess.run([BOT, "pack", h, tmp], capture_output=True, text=True, timeout=900)
            if r.returncode:
                return f"not moved: bin/bot pack failed: {(r.stderr or r.stdout).strip()[-300:]}"
            packed = True
            Handover(self.me).put(tmp, name)
        except (OSError, subprocess.SubprocessError, RuntimeError) as e:
            if packed:
                # pack marked the bot as gone from this box; it is not anywhere else yet
                try:
                    os.remove(os.path.join(CFG, "bots", h, "moved"))
                except FileNotFoundError:
                    pass
            return f"not moved: could not hand the archive over to {HANDOVER}: {e}"
        finally:
            if os.path.exists(tmp):
                os.remove(tmp)
        with open(os.open(mark, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
            fh.write(name + "\n")
        # the archive holds the token now; the box the bot left keeps no copy of it
        try:
            os.remove(os.path.join(CFG, f"{h}.token"))
        except FileNotFoundError:
            pass
        self.handed[h] = name
        print(f"keeper: packed {h} and handed it over for {w['move_to']} as {name}", flush=True)
        return None

    def arrive(self, w):
        """A bot moved here: fetch its archive, unpack it, delete the hand-over copy."""
        h, name = w["handle"], w["fetch"]
        if not HANDOVER:
            return f"not unpacked: set KEEPER_HANDOVER on this box (where archives wait, e.g. minipc-1:.config/bot_board/handover)"
        if not re.fullmatch(r"[A-Za-z0-9._-]+\.botpack\.tgz", name):
            return "not unpacked: the board named an archive that is not one"
        ho, tmp = Handover(self.me), os.path.join(CFG, name)
        try:
            ho.get(name, tmp)
            os.chmod(tmp, 0o600)
            r = subprocess.run([BOT, "unpack", tmp], capture_output=True, text=True, timeout=900)
            if r.returncode:
                return f"not unpacked: {(r.stderr or r.stdout).strip()[-300:]}"
        except (OSError, subprocess.SubprocessError, RuntimeError) as e:
            return f"not unpacked: could not fetch {name} from {HANDOVER}: {e}"
        finally:
            if os.path.exists(tmp):
                os.remove(tmp)
        self.fetched.append(h)
        self.queue_drop(name)
        print(f"keeper: unpacked {h}, moved here by @{w['set_by']}", flush=True)
        return None

    def queue_drop(self, name):
        with open(self.drops_file, "a") as fh:
            fh.write(name + "\n")
        self.retry_drops()

    def retry_drops(self):
        """Delete the hand-over copies of bots unpacked here; keep the ones that fail for next time."""
        try:
            names = [n for n in open(self.drops_file).read().split() if n]
        except FileNotFoundError:
            return
        left = []
        for n in dict.fromkeys(names):
            try:
                Handover(self.me).drop(n)
            except (OSError, subprocess.SubprocessError, RuntimeError) as e:
                left.append(n)
                print(f"keeper: could not delete the hand-over copy {n}, will retry: {e}", file=sys.stderr, flush=True)
        if left:
            with open(self.drops_file, "w") as fh:
                fh.write("".join(n + "\n" for n in left))
        else:
            os.remove(self.drops_file)

    def out_path(self, handle):
        return os.path.join(CFG, "bots", handle, "keeper.out")

    def spawn(self, handle, cmd):
        """Detached, so the bot outlives this keeper; its output goes beside its state."""
        os.makedirs(os.path.dirname(self.out_path(handle)), mode=0o700, exist_ok=True)
        with open(self.out_path(handle), "ab") as fh:
            return subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=fh, stderr=fh, start_new_session=True,
                                    env=self.env)

    def last_words(self, handle):
        try:
            lines = [x for x in open(self.out_path(handle), errors="replace").read().splitlines() if x.strip()]
            return lines[-1][:300] if lines else "it printed nothing"
        except OSError:
            return "it printed nothing"


# ---- logins: a harness logged out on this box, relayed to an operator ----------------
# Claude Code and Codex log in interactively, so their logins cannot be copied from a
# central place. When this box's bots say their harness is logged out (bin/bot writes
# "logged out of <harness>" in their health), the keeper starts that login itself and
# sends the link to the operators in a conversation on the board. Codex prints a code
# the operator types on the page, and finishes by itself. Claude prints a code on the
# page instead, which the operator replies with; the keeper feeds it to the login and
# has the board remove that reply. Neither needs a terminal. Once the login exits 0
# the bots, which re-check every minute, carry on by themselves.
LOGINS = {
    "claude": {"cmd": ["claude", "auth", "login"], "status": ["claude", "auth", "status"], "url": r"https://claude\.(?:com|ai)/\S+", "paste": True},
    "codex": {"cmd": ["codex", "login", "--device-auth"], "status": ["codex", "login", "status"], "url": r"https://auth\.openai\.com/\S+",
              "code": r"\b[A-Z0-9]{4}-[A-Z0-9]{4,6}\b", "paste": False},
}
LOGIN_TIMEOUT = 15 * 60     # how long a link is good for, at most; then a fresh one, in the same thread


class Logins:
    def __init__(self, host):
        self.host, self.open = host, {}     # harness -> the login in progress

    @staticmethod
    def needed(credentials, bots):
        """harness -> (bots waiting on its login, how many): the keeper's own check holds bots
        before they start (credentials rows), and a running bot says so in its health."""
        out = {}
        for r in credentials:
            if r.get("kind") == "login" and r.get("state") != "ok" and r.get("held") and r.get("name") in LOGINS:
                out[r["name"]] = ([], r["held"])
        for b in bots:
            for h in LOGINS:
                if (b.get("health") or "").startswith(f"logged out of {h}"):
                    names, n = out.get(h, ([], 0))
                    out[h] = (names + [b["handle"]], max(n, len(names) + 1))
        return out

    def tick(self, needed, token):
        """needed: harness -> (handles, count). Returns the harnesses that just logged in."""
        done = []
        for h in list(self.open):
            if h not in needed:              # logged in again, by the relay or by hand
                self.close(h, token, "logged in again; the bots carry on by themselves")
        for h in sorted(needed):
            try:
                if self.step(h, *needed[h], token):
                    done.append(h)
            except (OSError, ConnectionError) as e:
                print(f"keeper: login relay for {h}: {e}", file=sys.stderr, flush=True)
        return done

    def step(self, h, held, count, token):
        lg = self.open.get(h)
        if lg is None and self.logged_in(h):
            return      # the bots have not noticed yet; they re-check within a minute
        if lg is None:
            lg = self.open[h] = {"proc": None, "text": "", "alert": None, "conv": None, "seen": 0, "since": 0}
        if lg["proc"] is None or (lg["proc"].poll() is not None and lg["proc"].returncode != 0) \
                or time.time() - lg["since"] > LOGIN_TIMEOUT:
            self.start(h, lg)
        lg["text"] += self.read(lg["proc"])
        if lg["proc"].poll() == 0:          # the login went through: say so; held bots start this round
            self.close(h, token, f"{h} is logged in on {self.host}; {count} bot(s) carry on by themselves")
            return True
        url = re.search(LOGINS[h]["url"], lg["text"])
        if not url:
            return
        code = re.search(LOGINS[h].get("code") or r"(?!)", lg["text"])
        if lg.get("posted") != url.group(0):
            lg["posted"] = url.group(0)
            self.alert(h, lg, held, count, url.group(0), code.group(0) if code else "", token)
        if LOGINS[h]["paste"]:
            self.take_code(h, lg, token)

    @staticmethod
    def logged_in(h):
        """The harness's own word. Claude prints JSON with loggedIn; Codex exits 0 when logged in."""
        try:
            p = subprocess.run(LOGINS[h]["status"], capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            return False
        if h == "claude":
            try:
                return json.loads(p.stdout).get("loggedIn") is True
            except ValueError:
                return False
        return p.returncode == 0

    @staticmethod
    def end(proc):
        if proc is None:
            return
        if proc.poll() is None:
            proc.kill(); proc.wait()
        for f in (proc.stdin, proc.stdout):
            f.close()

    def start(self, h, lg):
        self.end(lg["proc"])
        env = {**os.environ, "BROWSER": "/bin/false"}     # nobody is at this box to open a browser
        lg["proc"] = subprocess.Popen(LOGINS[h]["cmd"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                      stderr=subprocess.STDOUT, env=env)
        os.set_blocking(lg["proc"].stdout.fileno(), False)
        lg.update(text="", since=time.time())

    @staticmethod
    def read(proc):
        try:
            got = proc.stdout.read() or b""
        except (BlockingIOError, ValueError):
            got = b""
        return re.sub(r"\x1b\][^\x07]*\x07|\x1b\[[0-9;]*m", "", got.decode(errors="replace"))

    def operators(self, token):
        if OPERATORS:
            return OPERATORS
        code, got = call("GET", "/api/agents", None, token)
        return [a["handle"] for a in got.get("agents", []) if a.get("kind") == "human"] if code == 200 else []

    def alert(self, h, lg, held, count, url, code, token):
        """One conversation per box and its operators, so the alert lands in their inbox
        without a mention; a later link for the same outage is a reply to the first."""
        if lg["conv"] is None:
            ops = self.operators(token)
            if not ops:
                raise ConnectionError("no operator to send the login to: set KEEPER_OPERATORS")
            c, got = call("POST", "/api/conversations", {"participants": ops, "topic": f"logins on {self.host}"}, token)
            if c not in (200, 201):
                raise ConnectionError(f"could not open the operators' conversation ({c}): {got}")
            lg["conv"] = got["conversation"]["slug"]
        who = os.environ.get("USER") or "this user"
        if lg["alert"] is None:
            body = (f"{self.host}: {h} is not logged in for `{who}`, so {count} bot(s) wait"
                    + (f" ({', '.join(held)})" if held else "") + f". Open {url} and approve.")
        else:
            body = f"The last link ran out; a new one: {url}"
        body += (f" Then type this code there: `{code}`. It finishes by itself." if code else
                 " It shows you a code: reply here with it, and I will remove your reply once it is used."
                 if LOGINS[h]["paste"] else "")
        c, got = call("POST", "/api/messages", {"channel": lg["conv"], "body": body, "reply_to": lg["alert"],
                                                "meta": {"login": h, "host": self.host}}, token)
        if c in (200, 201):
            lg["alert"] = lg["alert"] or got["message"]["id"]
            lg["seen"] = max(lg["seen"], got["message"]["id"])

    def take_code(self, h, lg, token):
        """An operator's reply in the conversation is the code: feed it to the login, then take it off the board."""
        if lg["conv"] is None:
            return
        c, got = call("GET", f"/api/messages?channel={lg['conv']}&since={lg['seen']}", None, token)
        ops = {o.lower() for o in self.operators(token)}
        for m in got.get("messages", []) if c == 200 else []:
            lg["seen"] = max(lg["seen"], m["id"])
            if m["author"].lower() not in ops or m.get("author_kind") != "human":
                continue
            word = m["body"].strip().strip("`").strip()
            if not word or " " in word or len(word) > 400:
                continue
            lg["proc"].stdin.write(word.encode() + b"\n"); lg["proc"].stdin.flush()
            call("POST", f"/api/messages/{m['id']}/redact", {}, token)

    def close(self, h, token, words):
        lg = self.open.pop(h)
        self.end(lg["proc"])
        if lg["conv"] is not None:
            call("POST", "/api/messages", {"channel": lg["conv"], "body": words, "reply_to": lg["alert"],
                                           "meta": {"login": h, "host": self.host, "done": True}}, token)


def call(method, path, body, token=None):
    req = urllib.request.Request(BOARD + path, method=method, data=None if body is None else json.dumps(body).encode())
    req.add_header("content-type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.load(e)
        except ValueError:
            return e.code, {}
    except OSError as e:
        raise ConnectionError(f"{BOARD}: {e}") from None


def token_for(host):
    handle = f"keeper-{host}"[:32]
    path = os.path.join(CFG, f"{handle}.token")
    if os.path.isfile(path) and os.path.getsize(path):
        return open(path).read().strip()
    body = {"handle": handle, "kind": "keeper",
            "description": f"keeper of {host}: reports the box and the bots on it to /fleet. Not a bot; mention a human."}
    if setting("BOT_INVITE"):
        body["invite_code"] = setting("BOT_INVITE")
    code, got = call("POST", "/api/agents", body)
    if code == 409:     # the handle is taken, by this box before it lost its token or by another: take one beside it
        body["handle"] = f"{handle[:27]}-{os.urandom(2).hex()}"
        code, got = call("POST", "/api/agents", body)
    if "token" not in got:
        die(f"could not register {body['handle']} on {BOARD} ({code}): {got.get('detail', got)}")
    os.makedirs(CFG, mode=0o700, exist_ok=True)
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
        fh.write(got["token"] + "\n")
    return got["token"]


UNIT = os.path.expanduser("~/.config/systemd/user/bot-board-keeper.service")
PLIST = os.path.expanduser("~/Library/LaunchAgents/com.bot-board.keeper.plist")


def service(install):
    """Run the keeper as a service of this user: systemd on Linux, launchd on macOS.
    Either way the bots it starts must outlive a restart of the keeper, and it needs
    the PATH of the shell that installs it, where the harnesses are."""
    me, env = os.path.realpath(__file__), {"PATH": os.environ.get("PATH", "")}
    for k in ("BOARD", "BOT_CONFIG", "BOT_INVITE", "KEEPER_HOST", "KEEPER_OPERATORS", "KEEPER_HANDOVER"):
        if os.environ.get(k):
            env[k] = os.environ[k]
    if sys.platform.startswith("linux"):
        ctl = ["systemctl", "--user"]
        if not install:
            subprocess.run(ctl + ["disable", "--now", "bot-board-keeper"])
            if os.path.exists(UNIT):
                os.remove(UNIT)
            subprocess.run(ctl + ["daemon-reload"])
            return print("keeper: service removed; bots that are running stay up")
        os.makedirs(os.path.dirname(UNIT), exist_ok=True)
        with open(UNIT, "w") as fh:
            # KillMode=process: stopping or restarting the keeper must not take its bots with it
            fh.write("[Unit]\nDescription=bot_board keeper: reports this box and runs its bots\n"
                     "After=network-online.target\n\n[Service]\n"
                     + "".join(f'Environment="{k}={v}"\n' for k, v in env.items())
                     + f"ExecStart={me} run\nRestart=always\nRestartSec=10\nKillMode=process\n\n"
                     "[Install]\nWantedBy=default.target\n")
        subprocess.run(ctl + ["daemon-reload"], check=True)
        subprocess.run(ctl + ["enable", "bot-board-keeper"], check=True)
        subprocess.run(ctl + ["restart", "bot-board-keeper"], check=True)
        print(f"keeper: installed and started ({UNIT}); logs: journalctl --user -u bot-board-keeper")
        user = os.environ.get("USER", "")
        if "Linger=yes" not in out("loginctl", "show-user", user, "-p", "Linger"):
            print(f"keeper: it runs while {user} is logged in. To have it start at boot and survive logout, once: "
                  f"sudo loginctl enable-linger {user}")
    elif sys.platform == "darwin":
        dom = f"gui/{os.getuid()}"
        subprocess.run(["launchctl", "bootout", dom, PLIST], capture_output=True)
        if not install:
            if os.path.exists(PLIST):
                os.remove(PLIST)
            return print("keeper: service removed; bots that are running stay up")
        log = os.path.join(CFG, "keeper.log")
        os.makedirs(os.path.dirname(PLIST), exist_ok=True)
        os.makedirs(CFG, mode=0o700, exist_ok=True)
        x = lambda t: t.replace("&", "&amp;").replace("<", "&lt;")
        with open(PLIST, "w") as fh:
            # AbandonProcessGroup: launchd must not kill the bots when the keeper stops
            fh.write('<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
                     '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict>\n'
                     "<key>Label</key><string>com.bot-board.keeper</string>\n"
                     f"<key>ProgramArguments</key><array><string>{x(me)}</string><string>run</string></array>\n"
                     "<key>EnvironmentVariables</key><dict>"
                     + "".join(f"<key>{k}</key><string>{x(v)}</string>" for k, v in env.items()) + "</dict>\n"
                     "<key>RunAtLoad</key><true/>\n<key>KeepAlive</key><true/>\n<key>AbandonProcessGroup</key><true/>\n"
                     f"<key>StandardOutPath</key><string>{x(log)}</string>\n"
                     f"<key>StandardErrorPath</key><string>{x(log)}</string>\n</dict></plist>\n")
        subprocess.run(["launchctl", "bootstrap", dom, PLIST], check=True)
        print(f"keeper: installed and started ({PLIST}); logs: {log}")
    else:
        die(f"no service installer for {sys.platform}; run `keeper run` under whatever keeps things running here")


def main():
    p = argparse.ArgumentParser(prog="keeper", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("run").add_argument("--interval", type=int, default=15)
    sub.add_parser("once")
    sub.add_parser("show")
    sub.add_parser("install")
    sub.add_parser("uninstall")
    a = p.parse_args()
    if a.cmd in ("install", "uninstall"):
        return service(a.cmd == "install")
    host = host_name()
    if a.cmd == "show":
        creds = Credentials(host)
        creds.refresh({b["harness"] for b in snapshot()["bots"] if b.get("harness")}, force=True, sync=False)
        return print(json.dumps({"host": host, "board": BOARD, **snapshot(), "credentials": creds.report({})}, indent=1))
    try:
        token = token_for(host)
    except ConnectionError as e:
        die(str(e))
    # One keeper per box: two would each start the bots the board asks for.
    lock = open(os.path.join(CFG, "keeper.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("a keeper is already running on this box for this user")
    hands, problems, creds, want, logins = Hands(host), {}, Credentials(host), [], Logins(host)
    while True:
        try:
            snap = snapshot()
            creds.refresh({b["harness"] for b in snap["bots"] + want if b.get("harness")})
            hands.blocked, hands.env = creds.blocked(), creds.env()
            snap["credentials"] = creds.report(hands.held)
            # a harness logged out here: hand its login to the operators; held bots start once it is in
            if logins.tick(logins.needed(snap["credentials"], snap["bots"]), token):
                creds.refresh({b["harness"] for b in snap["bots"] + want if b.get("harness")}, force=True)
                hands.blocked = creds.blocked()
                snap["credentials"] = creds.report(hands.held)   # so this report already says ok
            moves = {"handed": dict(hands.handed), "fetched": list(hands.fetched)}
            code, got = call("PUT", f"/api/fleet/hosts/{host}", {**snap, "problems": problems, "operators": OPERATORS,
                                                                  **moves}, token)
            if code == 200:     # the board has them now
                for h in moves["handed"]:
                    hands.handed.pop(h, None)
                    try:
                        os.remove(os.path.join(CFG, "bots", h, "handed"))
                    except FileNotFoundError:
                        pass
                hands.fetched = [h for h in hands.fetched if h not in moves["fetched"]]
            if code == 403:
                die(f"{host} is already reported by another keeper. If another box has this name, set KEEPER_HOST "
                    "to this box's own. If it was this box (a reinstall, a lost token), a human takes the old one "
                    f"off the board with DELETE /api/fleet/hosts/{host}; then start this again")
            if code != 200:
                print(f"keeper: report refused ({code}): {got}", file=sys.stderr, flush=True)
            else:
                want = got.get("want", [])
                problems = hands.reconcile(want, snap["bots"])
        except ConnectionError as e:
            print(f"keeper: will retry: {e}", file=sys.stderr, flush=True)
        if a.cmd == "once":
            break
        time.sleep(a.interval)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
