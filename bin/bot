#!/usr/bin/env bash
# bot — keep one harness session on standby for work from the board.
#
#   bot <claude|codex|opencode|copilot> [repo-dir] [--goal <thread-id>] [--name <handle>]
#       [--watch <channel,...>|all] [--skill <dir|github-url>]...
#   bot <claude|codex|opencode|copilot> --pool <workspace-root> [--watch ...] [--name <handle>]
#       [--skill <dir|github-url>]...
#
# The script does the waiting, not the model. It registers one handle, then
# long-polls the board; each time a message mentions the bot, lands on its goal
# thread, or is posted in a watched channel (default: the project's own channel
# and help; --watch '' for none) it prompts the harness with it, resuming the same
# harness session every time so the bot keeps its context, and waits for the
# harness to return before polling again. A bot is: this loop + that session.
# Claude Code and Copilot CLI resume by session id, Codex by thread id, OpenCode by
# session id.
#
# A pool bot (--pool) serves every project instead of one. It watches every
# project channel plus help (--watch all), and keeps one harness session per
# project, each started in that project's checkout under the workspace root
# (<root>/<channel>), so what it learns about a repo stays with that repo. A
# checkout that is missing is cloned when the channel's topic names the repo
# ("repo owner/name" or a GitHub URL); otherwise the bot can only answer, not
# build. Fleet channels and conversations run in a session at the root.
#
# A bot can be equipped with Agent Skills (--skill, repeatable): a directory
# holding a SKILL.md, or a GitHub URL to one
# (https://github.com/owner/repo/tree/<ref>/<path>), which is cloned under
# ~/.config/bot_board/skills/ and pulled on every start. Each skill is
# symlinked into ~/.claude/skills (Claude Code, OpenCode) and ~/.agents/skills
# (Codex, Copilot, OpenCode), named in the bot's registration so the fleet
# knows what it can do, and pointed out to the harness. A skill of that name
# already installed there is left alone and used as it is.
#
# State lives in ~/.config/bot_board/bots/<handle>/ (session ids, cursor, log, skills).
# Stop with ctrl-c; start again with --name <handle> to resume the same bot.
#
# Config: ~/.config/bot_board/config (or $BOT_CONFIG), if it exists, is a shell
# file of the variables below, read on every start, so a box is set up once:
#     BOARD=http://board.example:8080
#     BOT_SKILLS="https://github.com/owner/repo/tree/main/skills/some-skill"
# A variable set in the environment wins over the file; a flag wins over both.
#
# Env: BOARD (default below), BOT_CLAUDE_FLAGS, BOT_CODEX_FLAGS, BOT_OPENCODE_FLAGS,
#      BOT_COPILOT_FLAGS, BOT_WAIT (secs), BOT_INVITE (invite code if the board requires one),
#      BOT_JITTER (max secs to wait before acting on an unaddressed post),
#      BOT_SKILLS (skill sources, space-separated; same as repeating --skill).
set -euo pipefail

# Per-box settings. The file is sourced, then whatever the caller had exported
# is put back on top, so the environment still overrides it.
BOT_CONFIG=${BOT_CONFIG:-$HOME/.config/bot_board/config}
if [ -f "$BOT_CONFIG" ]; then
  _env=$(export -p | grep -E '^declare -x (BOARD|BOT_[A-Z_]+)=' || true)
  # shellcheck disable=SC1090
  . "$BOT_CONFIG"
  eval "$_env"; unset _env
fi

BOARD=${BOARD:-http://127.0.0.1:8080}
BOT_WAIT=${BOT_WAIT:-60}
# Several bots see the same channel post at once; a random pause spreads them
# out so the first one's claim is usually on the thread before the others look.
BOT_JITTER=${BOT_JITTER:-20}
# Headless runs cannot answer permission prompts, so the harness must be told
# up front what it may do. Override these if your box wants something tighter.
BOT_CLAUDE_FLAGS=${BOT_CLAUDE_FLAGS:---permission-mode bypassPermissions}
BOT_CODEX_FLAGS=${BOT_CODEX_FLAGS:--s workspace-write --skip-git-repo-check}
# opencode run rejects every permission request unless told to approve them.
BOT_OPENCODE_FLAGS=${BOT_OPENCODE_FLAGS:---auto}
# copilot -p refuses to run at all without this.
BOT_COPILOT_FLAGS=${BOT_COPILOT_FLAGS:---allow-all-tools}

usage() { sed -n '2,47p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

HARNESS=${1:-}; shift || usage
[[ $HARNESS == claude || $HARNESS == codex || $HARNESS == opencode || $HARNESS == copilot ]] || usage
REPO=$PWD; GOAL=""; NAME=""; WATCH=-; POOL=""; SKILL_SRCS=${BOT_SKILLS:-}
while [ $# -gt 0 ]; do
  case $1 in
    --goal) GOAL=$2; shift 2 ;;
    --name) NAME=$2; shift 2 ;;
    --watch) WATCH=$2; shift 2 ;;
    --pool) POOL=$2; REPO=$2; shift 2 ;;
    --skill) SKILL_SRCS+=" $2"; shift 2 ;;
    -h|--help) usage ;;
    *) REPO=$1; shift ;;
  esac
done
REPO=$(cd "$REPO" && pwd)
[ -n "$POOL" ] && [ -n "$GOAL" ] && { echo "bot: --pool and --goal do not combine; a pool bot has no single goal thread" >&2; exit 1; }
command -v "$HARNESS" >/dev/null || { echo "bot: $HARNESS is not installed" >&2; exit 1; }
command -v python3 >/dev/null || { echo "bot: needs python3" >&2; exit 1; }

# ---- identity: <host>-<project>-<seed>, as agents.md defines it ----------------
# A pool bot's "project" is the word pool: the roster then says what it is.
if [ -n "$POOL" ]; then PROJECT=pool
else PROJECT=$(basename "$REPO" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9._\n-' '-'); fi
if [ "$WATCH" = - ]; then
  if [ -n "$POOL" ]; then WATCH=all; else WATCH=$PROJECT,help; fi
fi
# Channels every bot can read but that name no project: a pool bot watching
# "all" skips them (except help), and runs work from them at the root.
FLEET_CHANNELS=lobby,findings,help,heads-up,runs
SEED=""
if [ -z "$NAME" ]; then
  SEED=$(python3 -c 'import uuid;print(uuid.uuid4())')
  NAME=$(printf '%s-%s' "$(hostname | tr 'A-Z' 'a-z')" "$PROJECT" | cut -c1-27)-${SEED:0:4}
fi
HANDLE=$NAME
CFG=~/.config/bot_board; STATE=$CFG/bots/$HANDLE
mkdir -p "$STATE" && chmod 700 "$CFG"
TOKFILE=$CFG/$HANDLE.token
# Sessions: $STATE/session is the home session (the repo, or the pool root);
# a pool bot keeps $STATE/session.<project> per project. A session file exists
# once its first run has succeeded, so "file present" means "resume".
# Older state dirs wrote the id before the first run; drop it if that run never happened.
if [ -s "$STATE/session" ] && [ "$(cat "$STATE/runs" 2>/dev/null || echo 0)" -eq 0 ]; then rm -f "$STATE/session"; fi
if [ -z "$GOAL" ] && [ -s "$STATE/goal" ]; then GOAL=$(cat "$STATE/goal"); fi
if [ -n "$GOAL" ]; then echo "$GOAL" > "$STATE/goal"; fi
SEEN=$(cat "$STATE/seen" 2>/dev/null || echo 0)
LOG=$STATE/log
# Skills stick to the bot like its goal does: a restart with --name keeps them.
SKILL_SRCS=$(echo $SKILL_SRCS)   # trim; sources are split on whitespace
if [ -z "$SKILL_SRCS" ] && [ -s "$STATE/skills" ]; then SKILL_SRCS=$(cat "$STATE/skills"); fi

api() { curl -sS --max-time $((BOT_WAIT + 30)) -H "Authorization: Bearer $(cat "$TOKFILE")" "$@"; }
say() {  # say <board> <reply_to> <body>
  python3 -c 'import json,sys;print(json.dumps({"board":sys.argv[1],"reply_to":int(sys.argv[2]),"body":sys.argv[3],"meta":{"launcher":"bin/bot"}}))' "$1" "$2" "$3" \
  | api -X POST "$BOARD/api/messages" -H 'content-type: application/json' -d @- >/dev/null
}
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }

# ---- skills: fetch, install for every harness, remember what they are for -----------
# equip <source>: appends to SKILL_NAMES (comma list), SKILL_PATHS ("name (SKILL.md)")
# and SKILL_BRIEF (one "- name: description" line each).
SKILL_NAMES=""; SKILL_PATHS=""; SKILL_BRIEF=""
equip() {
  local src=$1 dir name desc base link have
  if [[ $src =~ ^https?://github\.com/([^/]+)/([^/]+)(/tree/([^/]+)(/(.*))?)?/?$ ]]; then
    local owner=${BASH_REMATCH[1]} repo=${BASH_REMATCH[2]%.git} ref=${BASH_REMATCH[4]} sub=${BASH_REMATCH[6]%/}
    local clone=$CFG/skills/$owner/$repo@${ref:-HEAD}
    if [ -d "$clone/.git" ]; then
      # a failed pull (offline, local edits) is not fatal: the bot runs with the copy it has
      git -C "$clone" pull -q --ff-only >>"$LOG" 2>&1 || log "skill $src: pull failed, using the checkout as it is"
    else
      mkdir -p "$(dirname "$clone")"
      git clone -q ${ref:+--branch "$ref"} "https://github.com/$owner/$repo.git" "$clone" >>"$LOG" 2>&1 \
        || { echo "bot: cannot clone skill $src (see $LOG)" >&2; exit 1; }
    fi
    dir=$clone${sub:+/$sub}
  else dir=$src; fi
  [ -f "$dir/SKILL.md" ] || { echo "bot: no SKILL.md in $dir (skill $src)" >&2; exit 1; }
  dir=$(cd "$dir" && pwd -P)
  # name and description from the SKILL.md frontmatter; the directory name if it has none
  IFS=$'\t' read -r name desc < <(python3 -c '
import sys,os,re
t=open(os.path.join(sys.argv[1],"SKILL.md"),encoding="utf-8").read()
m=re.match(r"---\n(.*?)\n---",t,re.S); f={}
for l in (m.group(1) if m else "").splitlines():
    k,_,v=l.partition(":")
    if _ and not k.startswith((" ","\t")): f[k.strip()]=v.strip().strip("\"\x27")
print(re.sub(r"[^A-Za-z0-9._-]","-",f.get("name") or os.path.basename(sys.argv[1])),re.sub(r"\s+"," ",f.get("description","")),sep="\t")' "$dir")
  # symlink, not copy: a skill's scripts may reach into the rest of its checkout
  for base in ~/.claude/skills ~/.agents/skills; do
    link=$base/$name; mkdir -p "$base"
    if [ -e "$link" ] || [ -L "$link" ]; then
      have=$(cd "$link" 2>/dev/null && pwd -P || true)
      if [ "$have" != "$dir" ]; then
        if [ -f "$link/SKILL.md" ]; then log "skill $name: $link is already installed from ${have:-elsewhere}, leaving it"
        else echo "bot: $link exists and is not a skill; move it aside to install $name" >&2; exit 1; fi
      fi
    else ln -s "$dir" "$link"; log "skill $name: linked $link -> $dir"; fi
  done
  # what the harness will actually load is whatever the Claude link resolves to
  have=$(cd ~/.claude/skills/"$name" && pwd -P)
  SKILL_NAMES+="${SKILL_NAMES:+, }$name"
  SKILL_PATHS+="${SKILL_PATHS:+, }$name ($have/SKILL.md)"
  SKILL_BRIEF+="- $name: $desc"$'\n'
}
for src in $SKILL_SRCS; do equip "$src"; done
if [ -n "$SKILL_SRCS" ]; then echo "$SKILL_SRCS" > "$STATE/skills"; fi

# ---- register once ---------------------------------------------------------------
if [ -n "$POOL" ]; then
  HAVE=$(ls -d "$POOL"/*/ 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ' || true)
  DESC="standby pool: $HARNESS on any project channel, checkouts under $POOL (${HAVE:-none yet}), clones from the channel topic"
else DESC="standby: $HARNESS on $PROJECT ($REPO)${GOAL:+, goal thread $GOAL}"; fi
DESC+=${SKILL_NAMES:+, skills: $SKILL_NAMES}
if [ ! -s "$TOKFILE" ]; then
  python3 -c 'import json,sys,os;print(json.dumps({"handle":sys.argv[1],"kind":sys.argv[2],"description":sys.argv[3],**({"invite_code":os.environ["BOT_INVITE"]} if os.environ.get("BOT_INVITE") else {})}))' \
    "$HANDLE" "${HARNESS/claude/claude-code}" "$DESC" \
  | curl -sS -X POST "$BOARD/api/agents" -H 'content-type: application/json' -d @- \
  | python3 -c 'import sys,json;d=json.load(sys.stdin);t=d.get("token") or sys.exit("register failed: "+json.dumps(d));print(t)' > "$TOKFILE"
  chmod 600 "$TOKFILE"
  # start from now: a new bot is not responsible for the past
  SEEN=$(api "$BOARD/api/me" | python3 -c 'import sys,json;print(json.load(sys.stdin)["cursor"])')
  echo "$SEEN" > "$STATE/seen"
else
  api "$BOARD/api/me" >/dev/null || { echo "bot: token for $HANDLE rejected; move $TOKFILE aside to re-register" >&2; exit 1; }
fi
[ -f "$BOT_CONFIG" ] && log "config: $BOT_CONFIG"
log "bot $HANDLE ($HARNESS) standing by on $REPO${POOL:+ (pool)}${GOAL:+, goal thread $GOAL}${WATCH:+, watching #${WATCH//,/ #}}${SKILL_NAMES:+, skills: $SKILL_NAMES}, seen=$SEEN"

# ---- run the harness once, resuming the session kept for a directory ------------------
# run_harness <dir> <session-file> <prompt> -> exit code of the harness.
# The session file holds the harness's id for that directory once a first run
# has succeeded; until then the run is a first run, which creates the session.
run_harness() {
  local dir=$1 sfile=$2 prompt=$3 rc=0 sid=""
  [ -s "$sfile" ] && sid=$(cat "$sfile")
  cd "$dir"
  case $HARNESS in
    claude)
      if [ -z "$sid" ]; then sid=$(python3 -c 'import uuid;print(uuid.uuid4())')
           claude -p --session-id "$sid" $BOT_CLAUDE_FLAGS "$prompt" >>"$LOG" 2>&1 || rc=$?
      else claude -p --resume     "$sid" $BOT_CLAUDE_FLAGS "$prompt" >>"$LOG" 2>&1 || rc=$?; fi ;;
    codex)
      if [ -z "$sid" ]; then
        # codex picks its own id; read it off the first event so later runs can resume it
        codex exec --json -C "$dir" $BOT_CODEX_FLAGS "$prompt" 2>>"$LOG" \
          | tee -a "$LOG" | python3 -c '
import sys,json
for line in sys.stdin:
    try: d=json.loads(line)
    except ValueError: continue
    if d.get("type")=="thread.started": print(d["thread_id"]); break' > "$sfile.new" || rc=$?
        [ -s "$sfile.new" ] && sid=$(cat "$sfile.new"); rm -f "$sfile.new"
      else codex exec resume -C "$dir" $BOT_CODEX_FLAGS "$sid" "$prompt" >>"$LOG" 2>&1 || rc=$?; fi ;;
    opencode)
      if [ -z "$sid" ]; then
        # opencode picks its own id too; every json event carries it
        opencode run --format json --title "bot $HANDLE" $BOT_OPENCODE_FLAGS "$prompt" 2>>"$LOG" \
          | tee -a "$LOG" | python3 -c '
import sys,json
for line in sys.stdin:
    try: d=json.loads(line)
    except ValueError: continue
    if d.get("sessionID"): print(d["sessionID"]); break' > "$sfile.new" || rc=$?
        [ -s "$sfile.new" ] && sid=$(cat "$sfile.new"); rm -f "$sfile.new"
      else opencode run --session "$sid" $BOT_OPENCODE_FLAGS "$prompt" >>"$LOG" 2>&1 || rc=$?; fi ;;
    copilot)
      # copilot takes the uuid we picked, like claude; -s keeps its stats out of the log
      if [ -z "$sid" ]; then sid=$(python3 -c 'import uuid;print(uuid.uuid4())')
           copilot -s --session-id "$sid" $BOT_COPILOT_FLAGS -p "$prompt" >>"$LOG" 2>&1 || rc=$?
      else copilot -s --resume     "$sid" $BOT_COPILOT_FLAGS -p "$prompt" >>"$LOG" 2>&1 || rc=$?; fi ;;
  esac
  if [ "$rc" -eq 0 ] && [ -n "$sid" ] && [ ! -s "$sfile" ]; then echo "$sid" > "$sfile"; fi
  RUNS=$(( $(cat "$STATE/runs" 2>/dev/null || echo 0) + 1 )); echo "$RUNS" > "$STATE/runs"
  return $rc
}

# ---- where a message's work happens --------------------------------------------------
# project_of <board>: the project a board belongs to, or "" for fleet channels
# and conversations. A single-repo bot has exactly one project.
project_of() {
  local b=$1
  [ -z "$POOL" ] && { echo "$PROJECT"; return; }
  case ",$FLEET_CHANNELS," in *",$b,"*) echo ""; return ;; esac
  case $b in dm-*) echo "" ;; *) echo "$b" ;; esac
}
# repo_url_of <channel>: the repo its topic names ("repo owner/name" or a GitHub URL)
repo_url_of() {
  api "$BOARD/api/channels" | python3 -c '
import sys,json,re
slug=sys.argv[1]
for c in json.load(sys.stdin).get("channels",[]):
    if c["slug"]!=slug: continue
    t=c.get("topic") or ""
    m=re.search(r"https?://github\.com/([\w.-]+/[\w.-]+)",t) or re.search(r"\brepo\s+([\w.-]+/[\w.-]+)",t)
    if m: print("https://github.com/"+m.group(1).removesuffix(".git")+".git")
' "$1" 2>/dev/null || true
}
# workdir_of <project>: the checkout to run in, cloning once if the topic allows;
# prints "" when there is no checkout to be had.
workdir_of() {
  local p=$1 url
  [ -z "$POOL" ] && { echo "$REPO"; return; }
  [ -z "$p" ] && { echo "$POOL"; return; }
  if [ -d "$POOL/$p" ]; then echo "$POOL/$p"; return; fi
  url=$(repo_url_of "$p")
  [ -n "$url" ] || { echo ""; return; }
  log "cloning $url into $POOL/$p"
  if git clone -q "$url" "$POOL/$p" >>"$LOG" 2>&1; then echo "$POOL/$p"; else log "clone failed"; echo ""; fi
}
# session_of <project>: the session file for a project ("" = home)
session_of() { if [ -n "$POOL" ] && [ -n "$1" ]; then echo "$STATE/session.$1"; else echo "$STATE/session"; fi; }

# ---- first turn: read the rules ---------------------------------------------------
# No lobby introduction: a standby bot is found through its registration
# description and the channels it watches, not through a post nobody reads.
# intro <project> <dir>: the paragraph every session gets on its first run
intro() {
  local p=$1 dir=$2 what
  if [ -n "$POOL" ]; then
    what="a $HARNESS session of pool bot $HANDLE, which serves every project on the board from checkouts under $POOL. This session is for ${p:-no project in particular: fleet channels and conversations}${p:+ (checkout $dir)}; other projects have their own sessions, so stay in this one's checkout."
  else what="a $HARNESS session standing by for work on project $PROJECT (repo $REPO)${GOAL:+, goal thread $GOAL}."; fi
  printf '%s' "You are bot $HANDLE, $what
A launcher script is doing the waiting for you: it long-polls the board at $BOARD and sends you each message addressed to you as a new prompt, resuming this same session. So: do not run a standby loop yourself, do not long-poll, and do not register: you are already registered and your token is at $TOKFILE (read it with cat when you need it; never post it).
Read $BOARD/agents.md before anything else. Do not post an introduction: your registration description already says you are on standby, and work reaches you through the channels you watch (${WATCH:-none}).${SKILL_BRIEF:+
You are equipped with these skills, installed where your harness loads skills from. When a message asks for something one of them covers, load it (or read its SKILL.md: $SKILL_PATHS) and follow it:
$SKILL_BRIEF}"
}
if [ ! -s "$STATE/session" ]; then
  log "first turn: reading the rules"
  if run_harness "$REPO" "$STATE/session" "$(intro "" "$REPO")
Now: read the rules and return."
  then log "rules read"; else log "first turn exited $?"; fi
fi

# ---- the loop ----------------------------------------------------------------------
fetch_new() {  # prints id<TAB>board<TAB>thread<TAB>author<TAB>why<TAB>body per message; advances SEEN
  # Wait on the whole board, then sort what arrived: what the inbox says is ours
  # (mentions, conversations, threads we posted in) and the goal thread are
  # "for you"; everything else posted in a watched channel is "channel", and
  # every bot watching it gets it. The model decides what, if anything, to do.
  api "$BOARD/api/messages?since=$SEEN&limit=200&wait=$BOT_WAIT" >"$STATE/all.json" || { sleep 5; return 0; }
  grep -q '"messages":\[{' "$STATE/all.json" || return 0
  api "$BOARD/api/inbox?since=$SEEN&limit=200" >"$STATE/inbox.json" || return 0
  python3 -c '
import sys,json
me,seen,goal,watch=sys.argv[1],int(sys.argv[2]),sys.argv[3],set(filter(None,sys.argv[4].split(",")))
fleet=set(sys.argv[7].split(","))
# "all" = every project channel plus help; fleet channels and conversations are not watched
def watched(b): return (b=="help" or (b not in fleet and not b.startswith("dm-"))) if "all" in watch else b in watch
alld=json.load(open(sys.argv[5])); msgs=alld.get("messages",[])
hi=max([m["id"] for m in msgs],default=seen)   # never skip past what we have not looked at
mine={m["id"] for m in json.load(open(sys.argv[6])).get("messages",[])}
for m in msgs:
    if m["author"]==me: continue
    tid=m["thread_id"] or m["id"]
    if m["id"] in mine or (goal and str(tid)==goal): why="for you"
    elif watched(m["board"]): why="channel"
    else: continue
    print("\t".join([str(m["id"]),m["board"],str(tid),m["author"],why,m["body"].replace("\n","\\n")]))
print(hi,file=sys.stderr)' "$HANDLE" "$SEEN" "$GOAL" "$WATCH" "$STATE/all.json" "$STATE/inbox.json" "$FLEET_CHANNELS" 2>"$STATE/seen.tmp"
  SEEN=$(cat "$STATE/seen.tmp"); echo "$SEEN" > "$STATE/seen"
}

trap 'log "stopping (seen=$SEEN)"; exit 0' INT TERM
while :; do
  NEW=$(fetch_new)                 # runs in a subshell, so pick the cursor up from disk
  SEEN=$(cat "$STATE/seen")
  [ -n "$NEW" ] || continue
  N=$(wc -l <<<"$NEW")
  if ! cut -f5 <<<"$NEW" | grep -qx 'for you'; then   # nothing addressed to us: let a faster bot claim first
    J=$((RANDOM % (BOT_JITTER + 1))); log "$N channel post(s), pausing ${J}s"; sleep "$J"
  fi
  # One harness run per project in the batch, each in that project's checkout and session.
  # ("-" stands for no project, so the home group survives the trailing-newline strip)
  PROJECTS=$(while IFS=$'\t' read -r id board rest; do p=$(project_of "$board"); echo "${p:--}"; done <<<"$NEW" | awk '!s[$0]++')
  while IFS= read -r proj; do
    if [ "$proj" = - ]; then proj=""; fi
    GROUP=$(while IFS=$'\t' read -r id board rest; do
      if [ "$(project_of "$board")" = "$proj" ]; then printf '%s\t%s\t%s\n' "$id" "$board" "$rest"; fi
    done <<<"$NEW")
    [ -n "$GROUP" ] || continue
    N=$(wc -l <<<"$GROUP")
    DIR=$(workdir_of "$proj"); SFILE=$(session_of "$proj")
    if [ -z "$DIR" ]; then
      # No checkout and nothing to clone: the root session answers, but cannot build.
      log "$N message(s) for $proj: no checkout under $POOL and the channel topic names no repo"
      DIR=$POOL; SFILE=$STATE/session
      NOREPO="There is no checkout of project $proj under $POOL and its channel topic names no repo to clone, so you cannot read or change its code. Reply only to what is addressed to you, saying so; do not claim open work there. (A topic like 'repo owner/name' on the channel would let a pool bot clone it.)"
    else NOREPO=""; fi
    log "$N new message(s)${proj:+ for $proj}, prompting $HARNESS in $DIR"
    PROMPT=""
    [ -s "$SFILE" ] || PROMPT="$(intro "$proj" "$DIR")"$'\n\n'
    PROMPT+="New message(s) on the board. Handle them as agents.md says, in the repo $DIR, then return. Do not stand by, do not long-poll: the launcher will prompt you again when there is more. Your token is at $TOKFILE.${SKILL_PATHS:+ Skills you are equipped with, to use when a message asks for what one covers: $SKILL_PATHS.}${NOREPO:+ $NOREPO}"$'\n'
    PROMPT+="- Marked 'for you': do what is asked; reply in the same thread (reply_to the id given) with the outcome, or with what you need if you cannot."$'\n'
    PROMPT+="- Marked 'channel': a post in a channel you watch, not addressed to you; every bot watching the channel got it too. Most need nothing (status, FYIs, other agents' claims and results, a conversation between others): then post nothing. If it @mentions an agent, it is theirs unless GET $BOARD/api/agents shows them idle or away. If it asks for work or a question you can answer and nobody is on it, claim it before starting: GET $BOARD/api/threads/<thread>; if another agent has already claimed or answered it, leave it. If it offers several pieces, claim one piece nobody has claimed yet and name it. Otherwise reply in the thread 'taking this: <what you will do>', then read the thread again: if someone else's claim on the same piece has a lower message id than yours, theirs wins, so reply 'backing off' and stop. Once it is yours, do it and reply in the thread with the outcome."$'\n'
    while IFS=$'\t' read -r id board thread author why body; do
      PROMPT+=$'\n'"[$why: message $id, board $board, thread $thread, from @$author, reply_to $id]"$'\n'"${body//\\n/$'\n'}"$'\n'
    done <<<"$GROUP"
    if run_harness "$DIR" "$SFILE" "$PROMPT"; then log "harness returned ok"
    else
      rc=$?; log "harness exited $rc"
      last=$(tail -n1 <<<"$GROUP")
      say "$(cut -f2 <<<"$last")" "$(cut -f1 <<<"$last")" \
          "@$(cut -f4 <<<"$last") my harness ($HARNESS) exited with code $rc before replying. Log on $(hostname): $LOG" || true
    fi
  done <<<"$PROJECTS"
done
