#!/usr/bin/env bash
# forgejo-native — a Forgejo on this machine without Docker (#651, unit 2): fetch a pinned release, run it
# in the background beside the board, keep everything under ~/.bot_board/forgejo.
#
#   deploy/forgejo-native start     fetch it if needed, write its settings once, start it
#   deploy/forgejo-native stop      stop it
#   deploy/forgejo-native status    running or not, and the address
#   deploy/forgejo-native env       the variables deploy/forge-setup takes for this Forgejo
#
# Linux, amd64 or arm64, as the user that will own it (not root). The release is pinned below and checked
# against the pinned checksum; it is stored as forgejo-<version>, so a new pin is a new file and the old one stays.
# macOS: Forgejo publishes no macOS binary, so a Mac uses the one Homebrew installs (brew install forgejo, which
# this script runs when there is none; Homebrew checks it). It is not checked against the pin: the script says
# when its version differs. Homebrew has a bottle for Apple silicon; an Intel Mac builds it from source.
# SQLite, no ssh, no sign-up: the human and the bots' account are made by forge-setup.
#
# The port is the first free one from 3000, kept in the settings file afterwards; the board is at BOARD
# (default http://127.0.0.1:8080) and is the one address Forgejo may deliver webhooks to.
#
# Env: FORGEJO_DIR (default ~/.bot_board/forgejo), FORGEJO_PORT (a port to start the search at),
# FORGEJO_BIND (default 127.0.0.1), FORGEJO_HOST (the name in its address, default localhost),
# BOARD. For a test only: FORGEJO_BASE_URL (where the release files are) and FORGEJO_SHA256 (their checksum),
# both together; the script says so when it uses them instead of the pin. The free-port check looks at
# 127.0.0.1 only, which is right for the default FORGEJO_BIND.
set -euo pipefail

VERSION=17.0.2
SHA256_amd64=760cf8c6da9fb344908eebd1ebf920b79620fce6ebb22efa8f8c1e483652c1ee
SHA256_arm64=3ff8d0dadec454b1a19b1a52aded435bb6ade3a3c7a0a60e023e6b4cacf080ed

DIR=${FORGEJO_DIR:-$HOME/.bot_board/forgejo}
WORK=$DIR/work
INI=$WORK/custom/conf/app.ini
PIDFILE=$DIR/forgejo.pid
LOG=$DIR/forgejo.log
BOARD=${BOARD:-http://127.0.0.1:8080}
BIND=${FORGEJO_BIND:-127.0.0.1}
HOST=${FORGEJO_HOST:-localhost}

# a launchd or ssh shell on a Mac does not have Homebrew on its PATH
[ "$(uname -s)" != Darwin ] || PATH=$PATH:/opt/homebrew/bin:/usr/local/bin
# the binary: the pinned download on Linux, Homebrew's on a Mac (empty until it is installed)
if [ "$(uname -s)" = Darwin ]; then BIN=$(command -v forgejo || true); else BIN=$DIR/forgejo-$VERSION; fi

say() { echo "forgejo-native: $*"; }
die() { echo "forgejo-native: $*" >&2; exit 1; }
# the pid file may outlive a reboot, and the pid may then be another process: it counts only if it is our binary
running() {
  local pid
  pid=$(cat "$PIDFILE" 2>/dev/null || true)
  if [ -n "$pid" ] && [ -n "$BIN" ]; then
    # the binary itself, or (a script, as in the tests) a process that was started with it as an argument
    [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$BIN" ] && return 0
    if [ -r "/proc/$pid/cmdline" ]; then tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -qxF "$BIN" && return 0
    else ps -p "$pid" -o command= 2>/dev/null | grep -qF -- "$BIN" && return 0; fi      # macOS has no /proc
  fi
  rm -f "$PIDFILE"; return 1        # no process, or another one: the file is stale
}
port() { sed -n 's/^HTTP_PORT *= *//p' "$INI" 2>/dev/null | head -1; }
free() { ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

fetch() {
  local arch sum base bin=$BIN tmp ver
  if [ "$(uname -s)" = Darwin ]; then
    if [ -z "$BIN" ]; then
      command -v brew >/dev/null || die "Forgejo has no macOS download: install Homebrew (https://brew.sh), then run this again, or run brew install forgejo yourself"
      say "installing Forgejo with Homebrew"
      brew install forgejo || die "brew install forgejo failed"
      BIN=$(command -v forgejo || true); [ -n "$BIN" ] || die "brew installed Forgejo, but it is not on the PATH: $PATH"
    fi
    ver=$("$BIN" --version 2>/dev/null | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
    [ "$ver" = "$VERSION" ] || say "this Mac's Forgejo is ${ver:-of an unknown version}, the pin is $VERSION"
    return 0
  fi
  [ -x "$bin" ] && return 0
  case $(uname -s)-$(uname -m) in
    Linux-x86_64) arch=amd64; sum=$SHA256_amd64 ;;
    Linux-aarch64|Linux-arm64) arch=arm64; sum=$SHA256_arm64 ;;
    *) die "no Forgejo binary for $(uname -s) $(uname -m)" ;;
  esac
  base=https://codeberg.org/forgejo/forgejo/releases/download/v$VERSION
  if [ -n "${FORGEJO_SHA256:-}${FORGEJO_BASE_URL:-}" ]; then
    [ -n "${FORGEJO_SHA256:-}" ] && [ -n "${FORGEJO_BASE_URL:-}" ] || die "FORGEJO_SHA256 and FORGEJO_BASE_URL go together"
    sum=$FORGEJO_SHA256; base=$FORGEJO_BASE_URL
    say "NOT the pinned release: fetching from $base, checked against FORGEJO_SHA256"
  fi
  say "downloading Forgejo $VERSION"
  tmp=$(mktemp "$DIR/download.XXXXXX")
  curl -fsSL -o "$tmp" "$base/forgejo-$VERSION-linux-$arch" || { rm -f "$tmp"; die "could not download Forgejo from $base"; }
  echo "$sum  $tmp" | sha256sum -c --quiet - || { rm -f "$tmp"; die "the download does not match the pinned checksum: not used"; }
  chmod 755 "$tmp"; mv "$tmp" "$bin"
}

SETSID=$(command -v setsid || true)      # a closed terminal must not stop it

# the settings, written once: later runs keep the port and anything the user changed
settings() {
  [ ! -f "$INI" ] || return 0
  local p=${FORGEJO_PORT:-3000} board_host=${BOARD#*://}
  board_host=${board_host%%[:/]*}
  until free "$p"; do p=$((p + 1)); [ "$p" -lt 65000 ] || die "no free port found"; done
  mkdir -p "$(dirname "$INI")" "$WORK/data"
  (umask 077; cat > "$INI" <<EOF
APP_NAME = Fleet Forge
RUN_MODE = prod
WORK_PATH = $WORK

[server]
HTTP_ADDR = $BIND
HTTP_PORT = $p
DOMAIN = $HOST
ROOT_URL = http://$HOST:$p/
DISABLE_SSH = true

[database]
DB_TYPE = sqlite3
PATH = $WORK/data/forgejo.db

[repository]
ROOT = $WORK/repos

[security]
INSTALL_LOCK = true

[service]
DISABLE_REGISTRATION = true

[webhook]
; only the board may be delivered to, not every local or private address
ALLOWED_HOST_LIST = $board_host

[log]
ROOT_PATH = $DIR/log
EOF
  )
  say "settings written to $INI (port $p)"
}

start() {
  [ "$(id -u)" != 0 ] || die "run this as the user that will own Forgejo, not root"
  for c in curl $([ "$(uname -s)" = Darwin ] || echo sha256sum); do command -v $c >/dev/null || die "needs $c"; done
  mkdir -p "$DIR"; chmod 700 "$DIR"
  if running; then say "already running at http://$HOST:$(port)/"; return 0; fi
  fetch; settings
  ( cd "$WORK" && exec ${SETSID:-} "$BIN" --work-path "$WORK" web ) >"$LOG" 2>&1 </dev/null &
  echo $! > "$PIDFILE"; disown
  local i
  sleep 0.2      # the new process must have exec'd before running looks at it
  for i in $(seq 1 60); do
    curl -fs "http://127.0.0.1:$(port)/api/v1/version" >/dev/null 2>&1 && { say "Forgejo is at http://$HOST:$(port)/"; return 0; }
    running || break
    sleep 1
  done
  tail -n 20 "$LOG" >&2; die "Forgejo did not come up; log above, full log in $LOG"
}

stop() {
  running || { say "not running"; rm -f "$PIDFILE"; return 0; }
  local pid; pid=$(cat "$PIDFILE")
  kill "$pid"
  for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
  rm -f "$PIDFILE"; say "stopped"
}

case ${1:-} in
  start) start ;;
  stop) stop ;;
  status) if running; then say "running at http://$HOST:$(port)/"; else say "not running"; exit 1; fi
          want=${BOARD#*://}; want=${want%%[:/]*}
          [ "$(sed -n 's/^ALLOWED_HOST_LIST *= *//p' "$INI")" = "$want" ] \
            || say "the settings allow webhooks to $(sed -n 's/^ALLOWED_HOST_LIST *= *//p' "$INI"), not $want (BOARD): change ALLOWED_HOST_LIST in $INI and restart" ;;
  env) [ -f "$INI" ] || die "not set up: deploy/forgejo-native start"
       printf 'export FORGE=%q FORGEJO_BIN=%q FORGEJO_WORK_PATH=%q\n' "http://127.0.0.1:$(port)" "$BIN" "$WORK" ;;
  *) die "usage: forgejo-native start|stop|status|env" ;;
esac
