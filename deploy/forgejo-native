#!/usr/bin/env bash
# forgejo-native — a Forgejo on this machine without Docker (#651, unit 2): fetch a pinned release, run it
# in the background beside the board, keep everything under ~/.bot_board/forgejo.
#
#   deploy/forgejo-native start     fetch it if needed, write its settings once, start it
#   deploy/forgejo-native stop      stop it
#   deploy/forgejo-native status    running or not, and the address
#   deploy/forgejo-native env       the variables deploy/forge-setup takes for this Forgejo
#
# Linux, amd64 or arm64, as the user that will own it (not root). Forgejo publishes no macOS binary:
# on a Mac, install it with Homebrew (a later unit). The release is pinned below and checked against the
# pinned checksum; it is stored as forgejo-<version>, so a new pin is a new file and the old one stays.
# SQLite, no ssh, no sign-up: the human and the bots' account are made by forge-setup.
#
# The port is the first free one from 3000, kept in the settings file afterwards; the board is at BOARD
# (default http://127.0.0.1:8080) and is the one address Forgejo may deliver webhooks to.
#
# Env: FORGEJO_DIR (default ~/.bot_board/forgejo), FORGEJO_PORT (a port to start the search at),
# FORGEJO_BIND (default 127.0.0.1), FORGEJO_HOST (the name in its address, default localhost),
# BOARD. For a test: FORGEJO_BASE_URL (where the release files are) and FORGEJO_SHA256 (their checksum).
set -euo pipefail

VERSION=17.0.2
SHA256_amd64=760cf8c6da9fb344908eebd1ebf920b79620fce6ebb22efa8f8c1e483652c1ee
SHA256_arm64=3ff8d0dadec454b1a19b1a52aded435bb6ade3a3c7a0a60e023e6b4cacf080ed

DIR=${FORGEJO_DIR:-$HOME/.bot_board/forgejo}
WORK=$DIR/work
INI=$WORK/custom/conf/app.ini
PIDFILE=$DIR/forgejo.pid
LOG=$DIR/forgejo.log
BOARD=${BOARD:-http://127.0.0.1:8080}
BIND=${FORGEJO_BIND:-127.0.0.1}
HOST=${FORGEJO_HOST:-localhost}

say() { echo "forgejo-native: $*"; }
die() { echo "forgejo-native: $*" >&2; exit 1; }
running() { [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }
port() { sed -n 's/^HTTP_PORT *= *//p' "$INI" 2>/dev/null | head -1; }
free() { ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

fetch() {
  local arch sum base bin=$DIR/forgejo-$VERSION tmp
  [ -x "$bin" ] && return 0
  case $(uname -s)-$(uname -m) in
    Linux-x86_64) arch=amd64; sum=$SHA256_amd64 ;;
    Linux-aarch64|Linux-arm64) arch=arm64; sum=$SHA256_arm64 ;;
    *) die "no Forgejo binary for $(uname -s) $(uname -m): on a Mac, use Homebrew" ;;
  esac
  sum=${FORGEJO_SHA256:-$sum}
  base=${FORGEJO_BASE_URL:-https://codeberg.org/forgejo/forgejo/releases/download/v$VERSION}
  say "downloading Forgejo $VERSION"
  tmp=$(mktemp "$DIR/download.XXXXXX")
  curl -fsSL -o "$tmp" "$base/forgejo-$VERSION-linux-$arch" || { rm -f "$tmp"; die "could not download Forgejo from $base"; }
  echo "$sum  $tmp" | sha256sum -c --quiet - || { rm -f "$tmp"; die "the download does not match the pinned checksum: not used"; }
  chmod 755 "$tmp"; mv "$tmp" "$bin"
}

# the settings, written once: later runs keep the port and anything the user changed
settings() {
  [ ! -f "$INI" ] || return 0
  local p=${FORGEJO_PORT:-3000} board_host=${BOARD#*://}
  board_host=${board_host%%[:/]*}
  until free "$p"; do p=$((p + 1)); [ "$p" -lt 65000 ] || die "no free port found"; done
  mkdir -p "$(dirname "$INI")" "$WORK/data"
  (umask 077; cat > "$INI" <<EOF
APP_NAME = Fleet Forge
RUN_MODE = prod
WORK_PATH = $WORK

[server]
HTTP_ADDR = $BIND
HTTP_PORT = $p
DOMAIN = $HOST
ROOT_URL = http://$HOST:$p/
DISABLE_SSH = true

[database]
DB_TYPE = sqlite3
PATH = $WORK/data/forgejo.db

[repository]
ROOT = $WORK/repos

[security]
INSTALL_LOCK = true

[service]
DISABLE_REGISTRATION = true

[webhook]
; only the board may be delivered to, not every local or private address
ALLOWED_HOST_LIST = $board_host

[log]
ROOT_PATH = $DIR/log
EOF
  )
  say "settings written to $INI (port $p)"
}

start() {
  [ "$(id -u)" != 0 ] || die "run this as the user that will own Forgejo, not root"
  for c in curl sha256sum; do command -v $c >/dev/null || die "needs $c"; done
  mkdir -p "$DIR"; chmod 700 "$DIR"
  if running; then say "already running at http://$HOST:$(port)/"; return 0; fi
  fetch; settings
  ( cd "$WORK" && exec "$DIR/forgejo-$VERSION" --work-path "$WORK" web ) >"$LOG" 2>&1 </dev/null &
  echo $! > "$PIDFILE"; disown
  local i
  for i in $(seq 1 60); do
    curl -fs "http://127.0.0.1:$(port)/api/v1/version" >/dev/null 2>&1 && { say "Forgejo is at http://$HOST:$(port)/"; return 0; }
    running || break
    sleep 1
  done
  tail -n 20 "$LOG" >&2; die "Forgejo did not come up; log above, full log in $LOG"
}

stop() {
  running || { say "not running"; rm -f "$PIDFILE"; return 0; }
  local pid; pid=$(cat "$PIDFILE")
  kill "$pid"
  for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
  rm -f "$PIDFILE"; say "stopped"
}

case ${1:-} in
  start) start ;;
  stop) stop ;;
  status) if running; then say "running at http://$HOST:$(port)/"; else say "not running"; exit 1; fi ;;
  env) [ -f "$INI" ] || die "not set up: deploy/forgejo-native start"
       echo "FORGE=http://127.0.0.1:$(port) FORGEJO_BIN=$DIR/forgejo-$VERSION FORGEJO_WORK_PATH=$WORK" ;;
  *) die "usage: forgejo-native start|stop|status|env" ;;
esac
