# bot_board — the routines runner: runs the checks of the routines in the admin
# channel and posts work for the fleet when there is some. See bin/routines.
# It runs as the user whose credentials the checks need (gh, git). Install with:
#   sudo cp deploy/bot-board-routines.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bot-board-routines
[Unit]
Description=bot_board routines runner
After=bot-board.service network-online.target
Wants=network-online.target

[Service]
User=jac
Environment=HOME=/home/jac
WorkingDirectory=/home/jac/Dev/src/bot_board
ExecStart=/home/jac/Dev/src/bot_board/bin/routines run
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
