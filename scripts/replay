#!/usr/bin/env python3
"""Render a board thread as a silent vertical video replay (1080x1920 MP4, 15 to 30 seconds).

    scripts/replay 11533 -o replay.mp4                  # fetch the thread, write replay.mp4 + storyboard.json
    scripts/replay 11533 --pick 11533,11655,11684       # choose the beats yourself
    scripts/replay --storyboard storyboard.json -o r.mp4  # render an edited storyboard, no board needed

Messages pop in one at a time like a group chat: each bot has a name and a colour, and a bold caption
marks the beat. Forgejo review and merge lines become small event cards. Needs $BOARD and
$BOARD_TOKEN (or --board / --token) to fetch a thread, Pillow, and ffmpeg on the PATH (or the
imageio-ffmpeg package, which ships one). Music and a voice are added in the posting app.

By default the thread is filtered: @board nudges, release lines and routine boilerplate are dropped,
every text is cut to its first 140 characters at a sentence break, URLs are removed, attachments are
never read, and at most 9 beats are kept, in order, the first and the last always among them.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request

W, H = 1080, 1920
FPS = 24
MAX_BEATS, MAX_CHARS = 9, 140
PALETTE = ["#e4572e", "#17bebb", "#ffc914", "#76b041", "#9d6bff", "#ff7aa2", "#4ea5ff", "#ff9f1c"]
URL = re.compile(r"https?://\S+")


# ---------------------------------------------------------------- the thread -> a storyboard

def fetch(board: str, token: str, tid: int) -> list[dict]:
    req = urllib.request.Request(f"{board.rstrip('/')}/api/threads/{tid}", headers={"Authorization": "Bearer " + token})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)["messages"]


def clean(text: str) -> str:
    """First paragraph, markdown and links stripped, mentions flattened to the bare handle."""
    text = URL.sub("", text or "")
    para = next((p for p in re.split(r"\n\s*\n", text.strip()) if p.strip()), "")
    para = re.sub(r"^#+\s*|[`*_>]+", "", para)
    para = re.sub(r"\s+", " ", para).strip()
    return re.sub(r"(?<=[.!?])\s+[A-Z]\w*:$", "", para).rstrip(":")   # a link removed above can leave "Review:" dangling


def cut(text: str, limit: int = MAX_CHARS) -> str:
    if len(text) <= limit:
        return text
    head = text[:limit]
    ends = [m.end() for m in re.finditer(r"[.!?](?=\s)", head)]
    if ends and ends[-1] >= limit // 3:
        return head[:ends[-1]].strip()
    return head.rsplit(" ", 1)[0].rstrip(",;:") + "…"


def event_of(m: dict) -> str | None:
    """A Forgejo line from the board as a short event card, or None for any other board line. Every
    bot posts to Forgejo as "fleet", so the bot that wrote a review is read from the quoted
    signature line ("bot milo, board thread 11655"); a merge or close is by the human who did it."""
    lines = (m.get("body") or "").split("\n")
    hit = re.match(r"Forgejo: (\S+) (merged|reviewed|approved|requested changes on|opened|closed) (PR|issue) #(\d+)", lines[0])
    if not hit:
        return None
    who, what, kind, n = hit.groups()
    sig = next((re.match(r"> bot (\S+?),", l) for l in lines[1:] if l.startswith("> bot ")), None)
    if sig and who == "fleet":
        who = sig.group(1)
    return f"{who} {what} {kind} #{n}"


def caption_for(m: dict, text: str, first: bool, worker: str | None, ev: str | None) -> str:
    low = text.lower()
    if ev:
        return "merged" if " merged " in f" {ev} " else "review" if "review" in ev or "approved" in ev else "pushback" if "requested" in ev else ""
    if first:
        return "the ask"
    if re.search(r"send back|not yet|needs? (a )?fix|requested changes|should fix", low):
        return "pushback"
    if re.search(r"good to merge|reviewed|looks good|approve", low):
        return "review"
    if re.search(r"ready for review|please review|please look", low):
        return "ready"
    if m["author"] == worker:
        return "the answer"
    return ""


def storyboard(messages: list[dict], pick: list[int] | None) -> list[dict]:
    worker = next((m.get("worker") for m in messages if m.get("worker")), None)
    beats = []
    for i, m in enumerate(messages):
        meta = m.get("meta") or {}
        if pick is not None and m["id"] not in pick:
            continue
        if m["author"] == "board":
            ev = event_of(m)
            if not ev or (pick is None and not re.search(r"merged|reviewed|approved|requested", ev)):
                continue
            beats.append({"id": m["id"], "kind": "event", "author": "board", "text": ev,
                          "caption": caption_for(m, ev, False, worker, ev)})
            continue
        if pick is None and (meta.get("kind") in ("nudge", "thread_released") or meta.get("routine")):
            continue
        text = cut(clean(m.get("body", "")))
        if not text:
            continue
        beats.append({"id": m["id"], "kind": "message", "author": m["author"], "text": text,
                      "caption": caption_for(m, text, not beats, worker, None)})
    if pick is not None:
        beats.sort(key=lambda b: pick.index(b["id"]))
    elif len(beats) > MAX_BEATS:                      # keep the order; the first and the last stay
        keep = {round(k * (len(beats) - 1) / (MAX_BEATS - 1)) for k in range(MAX_BEATS)}
        beats = [b for k, b in enumerate(beats) if k in keep]
    return beats


# ---------------------------------------------------------------- the storyboard -> frames

def colours(story: list[dict]) -> dict[str, str]:
    """One palette colour per handle, in order of first appearance, so two bots never share one."""
    names = list(dict.fromkeys(b["author"] for b in story if b["kind"] == "message"))
    return {n: PALETTE[i % len(PALETTE)] for i, n in enumerate(names)}


def rgb(h: str) -> tuple[int, int, int]:
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def wrap(draw, text, font, width):
    lines, line = [], ""
    for word in text.split():
        trial = (line + " " + word).strip()
        if draw.textlength(trial, font=font) <= width or not line:
            line = trial
        else:
            lines.append(line)
            line = word
    return lines + ([line] if line else [])


def render(story: list[dict], title: str, out: str) -> None:
    from PIL import Image, ImageDraw, ImageFont

    font = lambda n: ImageFont.load_default(size=n)
    f_body, f_name, f_cap, f_small = font(50), font(40), font(96), font(36)
    scratch = ImageDraw.Draw(Image.new("RGB", (W, 10)))
    maxw = W - 2 * 70 - 2 * 36                        # text width inside a bubble

    def bold(d, xy, text, f, fill, stroke=2):         # the bundled font has no bold weight
        d.text(xy, text, font=f, fill=fill, stroke_width=stroke, stroke_fill=fill)

    paint = colours(story)
    bubbles = []
    for b in story:                                   # one RGBA image per beat
        if b["kind"] == "event":
            tw = int(scratch.textlength(b["text"], font=f_small))
            img = Image.new("RGBA", (tw + 110, 84), (0, 0, 0, 0))
            d = ImageDraw.Draw(img)
            d.rounded_rectangle((0, 0, img.width - 1, 83), 42, fill=(255, 255, 255, 34), outline=(255, 255, 255, 120), width=2)
            d.ellipse((36, 33, 54, 51), fill=(255, 201, 20, 255))         # the bundled font has no star glyph
            d.text((72, 20), b["text"], font=f_small, fill=(255, 255, 255, 255))
            bubbles.append((img, "centre"))
            continue
        lines = wrap(scratch, b["text"], f_body, maxw)
        h = 36 + 54 + len(lines) * 66 + 30
        img = Image.new("RGBA", (W - 140, h), (0, 0, 0, 0))
        d = ImageDraw.Draw(img)
        c = rgb(paint[b["author"]])
        d.rounded_rectangle((0, 0, img.width - 1, h - 1), 40, fill=(34, 36, 46, 255), outline=c + (255,), width=4)
        bold(d, (36, 26), "@" + b["author"], f_name, c, 1)
        for k, line in enumerate(lines):
            d.text((36, 36 + 54 + k * 66), line, font=f_body, fill=(240, 240, 240, 255))
        bubbles.append((img, "left"))

    n = len(story)
    total = min(30, max(15, 2.4 * n + 3))             # seconds
    hold = (total - 1.5) / n                          # per beat; the last one holds longer at the end
    top, bottom, gap = 360, H - 120, 28
    ys, y = [], 0
    for img, _ in bubbles:
        ys.append(y)
        y += img.height + gap
    heights = [img.height for img, _ in bubbles]

    def scroll_for(k):                                # content offset so beat k's bottom sits above `bottom`
        return max(0, ys[k] + heights[k] - (bottom - top))

    bg = Image.new("RGB", (W, H), (16, 17, 24))
    d = ImageDraw.Draw(bg)
    bold(d, (70, 90), "board thread #" + title, f_small, (150, 155, 175), 0)
    d.line((70, 150, W - 70, 150), fill=(60, 62, 76), width=3)

    ff = shutil.which("ffmpeg")
    if not ff:
        try:
            import imageio_ffmpeg
            ff = imageio_ffmpeg.get_ffmpeg_exe()
        except ImportError:
            sys.exit("replay: ffmpeg not found; install ffmpeg, or pip install imageio-ffmpeg")
    proc = subprocess.Popen([ff, "-y", "-loglevel", "error", "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{W}x{H}",
                             "-r", str(FPS), "-i", "-", "-an", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-crf", "20",
                             "-movflags", "+faststart", out], stdin=subprocess.PIPE)
    pop = 0.35
    for fr in range(int(total * FPS)):
        t = fr / FPS
        k = min(n - 1, int(t / hold)) if t >= 0.4 else -1         # the beat currently on screen
        local = (t - k * hold) if k >= 0 else 0
        p = min(1.0, local / pop) if k >= 0 else 1.0
        p = 1 - (1 - p) ** 3                                       # ease out
        frame = bg.copy()
        if k >= 0:
            prev = scroll_for(k - 1) if k > 0 else 0
            off = prev + (scroll_for(k) - prev) * p
            for j in range(k + 1):
                img, align = bubbles[j]
                yy = top + ys[j] - off
                if j == k:
                    yy += (1 - p) * 60
                if yy + img.height < 0 or yy > H:
                    continue
                x = (W - img.width) // 2 if align == "centre" else 70
                layer = img
                if j == k and p < 1:
                    layer = img.copy()
                    layer.putalpha(img.getchannel("A").point(lambda a: int(a * p)))
                frame.paste(layer, (x, int(yy)), layer)
            frame.paste(bg.crop((0, 0, W, 330)), (0, 0))      # header and caption zone: scrolled bubbles slide under it
            caption = story[k]["caption"]
            if caption:
                layer = Image.new("RGBA", (W, 170), (0, 0, 0, 0))
                cd = ImageDraw.Draw(layer)
                cw = int(cd.textlength(caption.upper(), font=f_cap))
                bold(cd, ((W - cw) // 2, 20), caption.upper(), f_cap, (255, 255, 255, int(255 * p)), 3)
                frame.paste(layer, (0, 160), layer)
        proc.stdin.write(frame.tobytes())
    proc.stdin.close()
    if proc.wait():
        sys.exit("replay: ffmpeg failed")


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("thread", nargs="?", type=int, help="board thread id")
    ap.add_argument("-o", "--out", default="replay.mp4", help="MP4 to write; storyboard.json goes beside it")
    ap.add_argument("--pick", help="comma-separated message ids to show, in this order")
    ap.add_argument("--storyboard", help="render this storyboard.json (as edited) instead of fetching a thread")
    ap.add_argument("--board", default=os.environ.get("BOARD"), help="board address (default $BOARD)")
    ap.add_argument("--token", default=os.environ.get("BOARD_TOKEN"), help="bearer token (default $BOARD_TOKEN)")
    a = ap.parse_args()
    if a.storyboard:
        data = json.load(open(a.storyboard))
        story, title = data["beats"], str(data.get("thread", ""))
    else:
        if not (a.thread and a.board and a.token):
            ap.error("give a thread id, and $BOARD and $BOARD_TOKEN (or --board and --token)")
        pick = [int(x) for x in a.pick.split(",")] if a.pick else None
        story, title = storyboard(fetch(a.board, a.token, a.thread), pick), str(a.thread)
        if not story:
            sys.exit("replay: nothing left to show after filtering")
        path = os.path.join(os.path.dirname(os.path.abspath(a.out)), "storyboard.json")
        with open(path, "w") as f:
            json.dump({"thread": a.thread, "beats": story}, f, indent=2, ensure_ascii=False)
        print("storyboard:", path)
    render(story, title, a.out)
    print("video:", a.out)


if __name__ == "__main__":
    main()
