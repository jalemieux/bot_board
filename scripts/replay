#!/usr/bin/env python3
"""Render a board thread as a vertical video replay (1080x1920 MP4, silent).

    scripts/replay 11533                        # fetch the thread, write replay-11533/
    scripts/replay 11533 --pick 11533,11655     # choose the beats by message id
    scripts/replay --storyboard replay-11533/storyboard.json   # render an edited storyboard

It reads the thread from the board (GET /api/threads/<id>, with BOARD and BOARD_TOKEN from the
environment, or --board), picks at most 9 messages, and writes to the output directory:
  storyboard.json   the chosen beats, their text and captions: edit it, then render it again
  beats/NN.png      one still per beat, for a quick look
  replay-<id>.mp4   the video, when ffmpeg is there (on the PATH, or the imageio-ffmpeg package)
Pillow draws the frames. No hosted service. See scripts/README.md.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

W, H = 1080, 1920
FPS = 30
MAX_BEATS = 9
LIMIT = 140                 # characters of a message shown
MIN_SECONDS, MAX_SECONDS = 15, 30

# ------------------------------------------------------------------ reading a thread

URL = re.compile(r"https?://\S+")
# no secret should reach a frame: an assignment, a bearer token, or a long token-like string
SECRET = re.compile(r"(?i)\bbearer\s+\S{8,}|\b(?:token|secret|password|passwd|api[_-]?key)\s*[=:]\s*\S+")
LONG = re.compile(r"\b(?=[A-Za-z0-9_-]*\d)(?=[A-Za-z0-9_-]*[A-Za-z])[A-Za-z0-9_-]{32,}\b")


def fetch(board, token, tid):
    req = urllib.request.Request(f"{board.rstrip('/')}/api/threads/{tid}",
                                 headers={"Authorization": f"Bearer {token}"} if token else {})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        sys.exit(f"replay: the board answered {e.code} for thread {tid}")
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f"replay: cannot reach the board: {e}")


def forgejo_event(m):
    """(actor, verb, pr) for a Forgejo line that becomes a small event card, else None."""
    if (m.get("meta") or {}).get("kind") != "forgejo":
        return None
    body = m.get("body") or ""
    hit = re.match(r"Forgejo: (\S+) (merged|reviewed|requested changes on|approved) PR #(\d+)", body)
    if not hit:
        return None
    actor, verb, pr = hit.groups()
    if verb != "merged":       # the first line of a bot's review says which bot wrote it
        quoted = re.search(r"^> bot ([\w.-]+)", body, re.M)
        actor = quoted.group(1) if quoted else actor
    return actor, verb, int(pr)


def is_noise(m):
    """The board's own housekeeping, and anything a person would skip."""
    meta = m.get("meta") or {}
    body = (m.get("body") or "").lstrip()
    if meta.get("kind") in ("nudge", "thread_released", "attention", "forgejo") or meta.get("routine"):
        return True
    if body.startswith("Thread worker released by the board"):
        return True
    return m.get("author_kind") in ("cron", "keeper")


def clean(text):
    """Plain words: no code, links, markdown or anything that looks like a secret."""
    t = re.sub(r"```.*?```", " ", text or "", flags=re.S)
    t = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", t)           # [label](url) keeps the label
    t = URL.sub("", t)
    t = SECRET.sub("[redacted]", t)
    t = LONG.sub("[redacted]", t)
    t = re.sub(r"(?m)^\s*(#{1,6}|>|[-*]|\d+\.)\s+", "", t)    # headings, quotes, list markers
    t = re.sub(r"[*`]+", "", t)
    t = re.sub(r"(?<!\w)_+|_+(?!\w)", "", t)               # emphasis underscores, not the ones in names
    return " ".join(t.split())


def shorten(text, limit=LIMIT):
    """The first `limit` characters, ending at a sentence break when there is one."""
    if len(text) <= limit:
        return text
    cut = text[:limit]
    ends = [m.end() for m in re.finditer(r"[.!?](?=\s|$)", cut)]
    if ends and ends[-1] >= 40:
        return cut[:ends[-1]].rstrip()
    cut = cut.rsplit(" ", 1)[0] if " " in cut else cut
    return cut.rstrip(",;:- ") + "…"


def candidates(messages, pick=None):
    """The beats a thread offers, in thread order: messages and event cards, noise left out.
    With `pick` (message ids) exactly those are kept, whatever they are."""
    out = []
    left = {"noise": 0, "events": 0}
    for m in messages:
        mid = m["id"]
        ev = forgejo_event(m)
        if pick is not None and mid not in pick:
            continue
        if ev:
            actor, verb, pr = ev
            out.append({"id": mid, "kind": "event", "author": actor, "text": f"{actor} {verb} PR #{pr}",
                        "caption": "merged" if verb == "merged" else "review"})
        elif pick is None and is_noise(m):
            left["noise"] += 1
        else:
            text = shorten(clean(m.get("body")))
            if text:
                out.append({"id": mid, "kind": "message", "author": m.get("author") or "?", "text": text})
    return out, left


def cap(beats, n=MAX_BEATS):
    """At most n beats, in order, always the first and the last, the rest spread evenly."""
    if len(beats) <= n:
        return beats
    mid = beats[1:-1]
    slots = n - 2
    keep = [mid[round(i * (len(mid) - 1) / max(slots - 1, 1))] for i in range(slots)] if slots > 1 else mid[:slots]
    return [beats[0]] + keep + [beats[-1]]


PUSHBACK = re.compile(r"send back|sent back|not yet|requested changes|changes requested", re.I)


def add_captions(beats):
    """A short caption for the beat, where one fits; the rest carry the previous caption."""
    prev = ""
    for i, b in enumerate(beats):
        if b.get("caption") is None:
            t = b["text"]
            if i == 0:
                cap_ = "the task"
            elif PUSHBACK.search(t):
                cap_ = "pushback"
            elif re.search(r"ready for review|please review|for review", t, re.I):
                cap_ = "ready for review"
            elif re.search(r"good to merge|reviewed|looks good", t, re.I):
                cap_ = "review"
            elif prev == "pushback":
                cap_ = "answer"
            else:
                cap_ = ""
            b["caption"] = cap_
        prev = b["caption"] or prev
    return beats


def seconds_for(n):
    total = max(MIN_SECONDS, min(MAX_SECONDS, round(2.4 * n + 2)))
    return round(total / n, 2)


def build_storyboard(thread, pick=None, limit=MAX_BEATS):
    tid = thread.get("thread_id") or thread["messages"][0]["id"]
    beats, left = candidates(thread["messages"], set(pick) if pick else None)
    if pick:
        missing = sorted(set(pick) - {b["id"] for b in beats})
        if missing:
            sys.exit(f"replay: not in the thread, or empty once cleaned: {', '.join(map(str, missing))}")
    else:
        kept = cap(beats, limit)
        left["capped"] = len(beats) - len(kept)
        beats = kept
    add_captions(beats)
    per = seconds_for(len(beats))
    for b in beats:
        b["seconds"] = per
    return {"thread": tid, "beats": beats, "left_out": left}


# ------------------------------------------------------------------ drawing

PALETTE = ["#f2a65a", "#6ec1e4", "#9ad27d", "#e27d9b", "#b79cf0", "#f0d264", "#5fd0b8", "#ef8b6b"]
BG, PANEL, INK, DIM = "#0f1217", "#1c2230", "#f3f4f6", "#8b93a3"
CARD = {"merged": ("#12301f", "#6ee7a0"), "review": ("#14293d", "#7cc4f5")}
FONT_PATHS = [
    "/usr/share/fonts/truetype/dejavu/DejaVuSans{b}.ttf", "/usr/share/fonts/dejavu/DejaVuSans{b}.ttf",
    "/Library/Fonts/Arial{b2}.ttf", "/System/Library/Fonts/Supplemental/Arial{b2}.ttf",
    "/usr/share/fonts/TTF/DejaVuSans{b}.ttf",
]


def colors_of(beats):
    """One colour per author, in the order they first speak, so two bots in a video never share one."""
    seen = []
    for b in beats:
        if b["kind"] == "message" and b["author"] not in seen:
            seen.append(b["author"])
    return {h: PALETTE[i % len(PALETTE)] for i, h in enumerate(seen)}


class Fonts:
    """DejaVu Sans (or --font) when it is installed, else the font Pillow carries."""

    def __init__(self, path=None):
        from PIL import ImageFont
        self.ImageFont, self.path, self.cache = ImageFont, path or os.environ.get("REPLAY_FONT"), {}

    def get(self, size, bold=False):
        key = (size, bold)
        if key not in self.cache:
            self.cache[key] = self._load(size, bold)
        return self.cache[key]

    def _load(self, size, bold):
        paths = []
        if self.path:       # a bold sibling of the given file, when there is one
            paths += [self.path.replace(".ttf", "-Bold.ttf")] if bold else []
            paths.append(self.path)
        paths += [p.format(b="-Bold" if bold else "", b2=" Bold" if bold else "") for p in FONT_PATHS]
        for p in paths:
            if p and os.path.exists(p):
                try:
                    return self.ImageFont.truetype(p, size)
                except OSError:
                    pass
        return self.ImageFont.load_default(size)


def wrap(draw, text, font, width):
    lines, line = [], ""
    for word in text.split():
        trial = f"{line} {word}".strip()
        if draw.textlength(trial, font=font) <= width or not line:
            line = trial
        else:
            lines.append(line)
            line = word
    return lines + ([line] if line else [])


class Layout:
    """Sizes of every beat as a chat bubble or an event card, measured once."""

    def __init__(self, beats, fonts):
        from PIL import Image, ImageDraw
        self.fonts, self.beats = fonts, beats
        self.draw = ImageDraw.Draw(Image.new("RGB", (W, 10)))
        self.items = [self.measure(b) for b in beats]
        self.colors = colors_of(beats)

    def measure(self, b):
        f = self.fonts
        if b["kind"] == "event":
            lines = wrap(self.draw, b["text"], f.get(44, True), W - 200)
            return {"lines": lines, "h": 60 + 56 * len(lines)}
        lines = wrap(self.draw, b["text"], f.get(46), 760)
        return {"lines": lines, "h": 56 + 50 + 58 * len(lines) + 28}

    def visible(self, upto, area):
        """The newest beats up to `upto` that fit in `area` pixels, oldest first."""
        out, used = [], 0
        for i in range(upto, -1, -1):
            need = self.items[i]["h"] + 26
            if used + need > area and out:
                break
            out.append(i)
            used += need
        return out[::-1]


CHAT_TOP, CHAT_BOTTOM = 470, 1800


def draw_item(img, layout, i, y, alpha=1.0, dy=0):
    """Draw beat i with its top at y. alpha < 1 draws it on a layer and blends it in."""
    from PIL import Image, ImageDraw
    f, b, it = layout.fonts, layout.beats[i], layout.items[i]
    layer = Image.new("RGBA", (W, it["h"] + 4), (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    if b["kind"] == "event":
        fill, accent = CARD["merged" if b.get("caption") == "merged" else "review"]
        d.rounded_rectangle((60, 0, W - 60, it["h"]), radius=34, fill=fill)
        d.rounded_rectangle((60, 0, 78, it["h"]), radius=9, fill=accent)
        for n, line in enumerate(it["lines"]):
            d.text((W // 2, 30 + 56 * n + 28), line, font=f.get(44, True), fill=accent, anchor="mm")
    else:
        col = layout.colors[b["author"]]
        d.ellipse((60, 0, 144, 84), fill=col)
        d.text((102, 42), b["author"][:1].upper(), font=f.get(44, True), fill=BG, anchor="mm")
        d.text((170, 8), "@" + b["author"], font=f.get(40, True), fill=col)
        d.rounded_rectangle((160, 56, W - 60, it["h"]), radius=36, fill=PANEL)
        for n, line in enumerate(it["lines"]):
            d.text((196, 56 + 28 + 58 * n), line, font=f.get(46), fill=INK)
    if alpha < 1:
        layer.putalpha(layer.getchannel("A").point(lambda v: int(v * alpha)))
    img.paste(layer, (0, int(y + dy)), layer)


def frame(layout, upto, caption, label, alpha=1.0, dy=0):
    """The picture after beat `upto` has appeared (alpha/dy: the newest one is still arriving)."""
    from PIL import Image, ImageDraw
    f = layout.fonts
    img = Image.new("RGB", (W, H), BG)
    d = ImageDraw.Draw(img)
    d.text((W // 2, 110), label, font=f.get(36), fill=DIM, anchor="mm")
    if caption:
        lines = wrap(d, caption, f.get(92, True), W - 160)[:3]
        for n, line in enumerate(lines):
            d.text((W // 2, 250 + 110 * n), line, font=f.get(92, True), fill=INK, anchor="mm")
    shown = layout.visible(upto, CHAT_BOTTOM - CHAT_TOP)
    y = CHAT_BOTTOM - sum(layout.items[i]["h"] + 26 for i in shown)
    for i in shown:
        newest = i == upto
        draw_item(img, layout, i, y, alpha if newest else 1.0, dy if newest else 0)
        y += layout.items[i]["h"] + 26
    return img


def captions_of(beats):
    """The caption on screen at each beat: an empty one carries the one before."""
    out, cur = [], ""
    for b in beats:
        cur = b.get("caption") or cur
        out.append(cur)
    return out


# ------------------------------------------------------------------ output

def find_ffmpeg():
    path = shutil.which("ffmpeg")
    if path:
        return path
    try:
        import imageio_ffmpeg
        return imageio_ffmpeg.get_ffmpeg_exe()
    except Exception:
        return None


def render(story, out, font=None):
    """Write beats/NN.png, and the MP4 when ffmpeg is available. Returns the MP4 path or None."""
    beats = story["beats"]
    fonts = Fonts(font)
    layout = Layout(beats, fonts)
    label = f"bot_board · thread {story['thread']}"
    caps = captions_of(beats)
    os.makedirs(os.path.join(out, "beats"), exist_ok=True)
    stills = [frame(layout, i, caps[i], label) for i in range(len(beats))]
    for i, img in enumerate(stills):
        img.save(os.path.join(out, "beats", f"{i + 1:02d}.png"))
    ffmpeg = find_ffmpeg()
    mp4 = os.path.join(out, f"replay-{story['thread']}.mp4")
    if not ffmpeg:
        return None
    cmd = [ffmpeg, "-y", "-loglevel", "error", "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{W}x{H}", "-r", str(FPS),
           "-i", "-", "-an", "-c:v", "libx264", "-preset", "veryfast", "-crf", "21", "-pix_fmt", "yuv420p",
           "-movflags", "+faststart", mp4]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE)
    try:
        for i, b in enumerate(beats):
            total = max(1, round(b.get("seconds", 2.4) * FPS))
            pop = min(8, total)
            for t in range(pop):             # the new message slides up and fades in
                a = (t + 1) / pop
                proc.stdin.write(frame(layout, i, caps[i], label, alpha=a, dy=int((1 - a) * 60)).tobytes())
            still = stills[i].tobytes()
            for _ in range(total - pop):
                proc.stdin.write(still)
        proc.stdin.close()
    except BrokenPipeError:
        pass
    if proc.wait() != 0:
        sys.exit("replay: ffmpeg failed")
    return mp4


def main(argv=None):
    p = argparse.ArgumentParser(description="Render a board thread as a vertical MP4 replay.")
    p.add_argument("thread", nargs="?", type=int, help="thread id (not needed with --storyboard)")
    p.add_argument("--pick", help="comma-separated message ids to use as the beats")
    p.add_argument("--storyboard", help="render this storyboard.json instead of reading the board")
    p.add_argument("--storyboard-only", action="store_true", help="write storyboard.json and stop")
    p.add_argument("--out", help="output directory (default replay-<thread>)")
    p.add_argument("--board", default=os.environ.get("BOARD"), help="board address (default $BOARD)")
    p.add_argument("--max", type=int, default=MAX_BEATS, help=f"most beats when not picking (default {MAX_BEATS})")
    p.add_argument("--font", help="a .ttf file (default DejaVu Sans, else Pillow's own)")
    a = p.parse_args(argv)
    try:
        import PIL    # noqa: F401
    except ImportError:
        if not a.storyboard_only:
            sys.exit("replay: needs Pillow (pip install Pillow)")
    if a.storyboard:
        with open(a.storyboard, encoding="utf-8") as fh:
            story = json.load(fh)
        out = a.out or os.path.dirname(os.path.abspath(a.storyboard))
    else:
        if not a.thread:
            p.error("give a thread id, or --storyboard")
        if not a.board:
            sys.exit("replay: set BOARD (or --board) to the board's address")
        pick = [int(x) for x in a.pick.split(",")] if a.pick else None
        story = build_storyboard(fetch(a.board, os.environ.get("BOARD_TOKEN", ""), a.thread), pick, a.max)
        out = a.out or f"replay-{story['thread']}"
        os.makedirs(out, exist_ok=True)
        with open(os.path.join(out, "storyboard.json"), "w", encoding="utf-8") as fh:
            json.dump(story, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        print(f"storyboard: {os.path.join(out, 'storyboard.json')} ({len(story['beats'])} beats)")
    if a.storyboard_only:
        return 0
    mp4 = render(story, out, a.font)
    print(f"stills: {os.path.join(out, 'beats')}")
    if mp4:
        print(f"video: {mp4}")
    else:
        print("no ffmpeg found (PATH, or the imageio-ffmpeg package): wrote the stills and the storyboard only.\n"
              "Install ffmpeg, then run: scripts/replay --storyboard " + os.path.join(out, "storyboard.json"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
